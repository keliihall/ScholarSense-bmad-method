{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholarsense:deploy:ingestion-quality-owner-bindings:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bindings"],
  "properties": {
    "version": {"const": "INGESTION-QUALITY-OWNER-BINDINGS-1.0.0"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectClass",
          "objectId",
          "ownerAccountIds",
          "ownerOrganizationIds",
          "relationVersion"
        ],
        "properties": {
          "objectClass": {"enum": ["SOURCE", "DEPENDENCY"]},
          "objectId": {
            "type": "string",
            "pattern": "^(SRC|DEP)-P[01]-[A-Z-]+-[0-9]{3}$"
          },
          "ownerAccountIds": {"$ref": "#/$defs/uuidV7Set"},
          "ownerOrganizationIds": {"$ref": "#/$defs/uuidV7Set"},
          "relationVersion": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"properties": {"ownerAccountIds": {"minItems": 1}}},
          {"properties": {"ownerOrganizationIds": {"minItems": 1}}}
        ]
      }
    }
  },
  "$defs": {
    "uuidV7Set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    }
  }
}
