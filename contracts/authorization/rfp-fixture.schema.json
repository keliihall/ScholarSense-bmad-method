{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/authorization/rfp-fixture.schema.json",
  "title": "ScholarSense RFP deterministic oracle fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "fixtureVersion", "policyVersion", "serverNow", "subjects", "objects", "oracle"
  ],
  "properties": {
    "$schema": {"const": "./rfp-fixture.schema.json"},
    "fixtureVersion": {"const": "RFP-FIXTURE-1.0.0"},
    "policyVersion": {"const": "RFP-1.0.0"},
    "serverNow": {"const": "2026-07-17T08:00:00Z"},
    "subjects": {
      "type": "array", "minItems": 7, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["subjectId", "roleIds", "identityVersion", "responsibilityVersion", "invalidationVersion"],
        "properties": {
          "subjectId": {"type": "string", "pattern": "^SUBJECT-[A-Z0-9+-]+$"},
          "roleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^R[1-7]$"}},
          "identityVersion": {"type": "integer", "minimum": 1},
          "responsibilityVersion": {"type": "integer", "minimum": 1},
          "invalidationVersion": {"type": "integer", "minimum": 0}
        }
      }
    },
    "objects": {
      "type": "array", "minItems": 11,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["objectToken", "objectClass", "objectVersion", "anchors", "fieldAllowlist"],
        "properties": {
          "objectToken": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "objectClass": {"type": "string", "minLength": 1},
          "objectVersion": {"type": "integer", "minimum": 1},
          "anchors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "purpose": {"type": ["string", "null"]},
          "fieldAllowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "taskWindow": {
            "type": "object", "additionalProperties": false,
            "required": ["startAt", "endAt"],
            "properties": {
              "startAt": {"type": "string", "format": "date-time"},
              "endAt": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    "oracle": {
      "type": "array", "minItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenarioId", "subjectId", "objectToken", "actionId", "expectedResult", "expectedReason"],
        "properties": {
          "scenarioId": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "subjectId": {"type": "string"},
          "objectToken": {"type": "string"},
          "actionId": {"type": "string"},
          "expectedResult": {"enum": ["ALLOW", "DENY", "DEPENDENCY_UNAVAILABLE"]},
          "expectedReason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "additionalAnchors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "expectedFieldVisibility": {
            "type": "object", "additionalProperties": false,
            "required": ["B", "I", "C", "S", "E", "N", "G", "T"],
            "properties": {
              "B": {"enum": ["C", "M", "H"]}, "I": {"enum": ["C", "M", "H"]},
              "C": {"enum": ["C", "M", "H"]}, "S": {"enum": ["C", "M", "H"]},
              "E": {"enum": ["C", "M", "H"]}, "N": {"enum": ["C", "M", "H"]},
              "G": {"enum": ["C", "M", "H"]}, "T": {"enum": ["C", "M", "H"]}
            }
          }
        }
      }
    }
  }
}
