{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/authorization/high-risk/high-risk-approval-receipt.schema.json",
  "title": "Immutable high-risk approval receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "approvalId", "approvalVersion", "requestId", "requestDigest", "actionType",
    "makerPrincipalDigest", "decisionActorPrincipalDigest", "checkerSetDigest", "checkerQuorum",
    "objectType", "objectRefDigest", "objectVersion", "scopeDigest", "impactScopeDigest",
    "dataSensitivity", "currentState", "targetState", "reasonCode", "matrixVersion",
    "matrixDigest", "policyVersion", "policyDigest", "roleFieldPolicyVersion",
    "roleFieldPolicyDigest", "previewDigest", "authorizationContextDigest",
    "authenticationStateDigest", "authorizationGeneration", "status", "decidedAt", "expiresAt",
    "receiptDigest", "issuer", "keyVersion", "signature", "traceId"
  ],
  "properties": {
    "schemaVersion": {"const": "HIGH-RISK-APPROVAL-RECEIPT-1.0.0"},
    "approvalId": {"$ref": "#/$defs/uuidV7"},
    "approvalVersion": {"type": "integer", "minimum": 1},
    "requestId": {"$ref": "#/$defs/uuidV7"},
    "requestDigest": {"$ref": "#/$defs/sha256"},
    "actionType": {"$ref": "#/$defs/actionType"},
    "makerPrincipalDigest": {"$ref": "#/$defs/sha256"},
    "decisionActorPrincipalDigest": {"$ref": "#/$defs/sha256"},
    "checkerSetDigest": {"$ref": "#/$defs/sha256"},
    "checkerQuorum": {"enum": ["all-distinct-business-owner-bindings"]},
    "objectType": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "objectRefDigest": {"$ref": "#/$defs/sha256"},
    "objectVersion": {"type": "integer", "minimum": 1},
    "scopeDigest": {"$ref": "#/$defs/sha256"},
    "impactScopeDigest": {"$ref": "#/$defs/sha256"},
    "dataSensitivity": {"enum": ["internal", "sensitive", "highly-sensitive-deidentified"]},
    "currentState": {"type": "string", "minLength": 1, "maxLength": 64},
    "targetState": {"type": "string", "minLength": 1, "maxLength": 64},
    "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "matrixVersion": {"$ref": "#/$defs/version"},
    "matrixDigest": {"$ref": "#/$defs/sha256"},
    "policyVersion": {"$ref": "#/$defs/version"},
    "policyDigest": {"$ref": "#/$defs/sha256"},
    "roleFieldPolicyVersion": {"$ref": "#/$defs/version"},
    "roleFieldPolicyDigest": {"$ref": "#/$defs/sha256"},
    "previewDigest": {"$ref": "#/$defs/sha256"},
    "authorizationContextDigest": {"$ref": "#/$defs/sha256"},
    "authenticationStateDigest": {"$ref": "#/$defs/sha256"},
    "authorizationGeneration": {"type": "integer", "minimum": 0},
    "status": {"enum": ["approved", "rejected", "expired", "cancelled"]},
    "decidedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "receiptDigest": {"$ref": "#/$defs/sha256"},
    "issuer": {"const": "identity-access"},
    "keyVersion": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,512}$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  },
  "$defs": {
    "uuidV7": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "actionType": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}
  }
}
