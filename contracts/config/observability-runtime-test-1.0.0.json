{
  "$schema": "./observability-runtime.schema.json",
  "profileVersion": "OBS-RUNTIME-1.0.0",
  "environment": "test",
  "role": "worker",
  "otlp": {"enabled": false, "protocol": "http/protobuf", "timeoutMs": 2000, "maxQueueSize": 2048},
  "sampling": {"sampler": "parent-based-trace-id-ratio", "probability": 1.0},
  "resource": {"service": "scholarsense", "module": "worker"},
  "trustedIngress": {"profileVersion":"TRUSTED-INGRESS-1.0.0","socketSources":["127.0.0.1","::1"],"proxyIdentity":"portal-proxy-test-v1","proxyClearsPropagationHeaders":true},
  "structuredLogging": {"format":"scholarsense-json-1","timestampZone":"UTC","fields":["timestamp","level","service","module","traceId","event","code"],"arbitraryMdc":"forbidden"},
  "baggage": "forbidden",
  "runtimeEvidenceClaim": "conformance-only"
}
