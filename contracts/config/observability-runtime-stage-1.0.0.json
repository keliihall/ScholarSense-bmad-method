{
  "$schema": "./observability-runtime.schema.json",
  "profileVersion": "OBS-RUNTIME-1.0.0",
  "environment": "stage",
  "role": "web-api",
  "otlp": {"enabled": true, "endpoint":"https://otel.stage.scholarsense.suda.edu.cn/v1/traces","metricsEndpoint":"https://otel.stage.scholarsense.suda.edu.cn/v1/metrics","protocol":"http/protobuf","timeoutMs":2000,"maxQueueSize":2048},
  "sampling": {"sampler": "parent-based-trace-id-ratio", "probability": 0.1},
  "resource": {"service": "scholarsense", "module": "web-api"},
  "trustedIngress": {"profileVersion":"TRUSTED-INGRESS-1.0.0","socketSources":["10.20.0.10"],"proxyIdentity":"portal-proxy-stage-v1","proxyClearsPropagationHeaders":true},
  "structuredLogging": {"format":"scholarsense-json-1","timestampZone":"UTC","fields":["timestamp","level","service","module","traceId","event","code"],"arbitraryMdc":"forbidden"},
  "baggage": "forbidden",
  "runtimeEvidenceClaim": "none"
}
