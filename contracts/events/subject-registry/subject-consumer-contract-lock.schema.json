{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/events/subject-registry/subject-consumer-contract-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockVersion", "digests"],
  "properties": {
    "lockVersion": {"const": "SUBJECT-CONSUMER-LOCK-1.0.0"},
    "digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
  }
}
