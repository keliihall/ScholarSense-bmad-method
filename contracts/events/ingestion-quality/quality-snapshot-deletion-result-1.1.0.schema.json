      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerId",
        "registryMembership",
        "lifecycleStatus",
        "watermarkStatus",
        "requiredAggregateVersion",
        "confirmedAggregateVersion",
        "transportAck",
        "inboxAck",
        "evidenceCopyAck",
        "attestation"
