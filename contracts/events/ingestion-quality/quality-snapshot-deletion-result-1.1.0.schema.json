{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-snapshot-deletion-result-1.1.0.schema.json",
  "title": "ScholarSense QualitySnapshot Production Deletion Result Event 1.1.0",
  "$defs": {
    "uuidV7": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableUuidV7": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuidV7"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "traceId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[A-Z][A-Z0-9_]{2,99}(?![\\s\\S])"
    },
    "failureCode": {
      "enum": [
        "INDEX_DELETE_FAILED",
        "OBJECT_DELETE_FAILED",
        "OWNER_STORE_UNAVAILABLE"
      ]
    },
    "blockerCode": {
      "enum": [
        "LEGAL_HOLD_MATCHED",
        "RETENTION_NOT_DUE",
        "CONSUMER_WATERMARK_BEHIND",
        "CONSUMER_WATERMARK_MISSING",
        "CONSUMER_WATERMARK_UNKNOWN",
        "EVIDENCE_COPY_ACK_MISSING",
        "TRUSTED_TIME_UNAVAILABLE",
        "LEGAL_HOLD_DEPENDENCY_UNAVAILABLE",
        "WATERMARK_DEPENDENCY_UNAVAILABLE",
        "CONSUMER_REGISTRY_UNAVAILABLE"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectType",
        "snapshotId",
        "sourceId",
        "snapshotAggregateVersion",
        "evaluatedAt",
        "retentionDueAt",
        "snapshotImmutableHash",
        "scopeDigest"
      ],
      "properties": {
        "objectType": {
          "const": "QualitySnapshot"
        },
        "snapshotId": {
          "$ref": "#/$defs/uuidV7"
        },
        "sourceId": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128,
          "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}(?![\\s\\S])"
        },
        "snapshotAggregateVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evaluatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "retentionDueAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshotImmutableHash": {
          "$ref": "#/$defs/digest"
        },
        "scopeDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "trustedTimeGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "legalHoldGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkedScopeDigest",
        "matchedCount",
        "matchedScopeDigests",
        "checkedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "clear",
            "matched",
            "unavailable"
          ]
        },
        "checkedScopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "matchedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matchedScopeDigests": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "registryMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerId",
        "registryMembership",
        "lifecycleStatus"
      ],
      "properties": {
        "consumerId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]{2,79}(?![\\s\\S])"
        },
        "registryMembership": {
          "enum": [
            "required-for-snapshot",
            "unreleased-reference-holder",
            "planned-never-held-reference"
          ]
        },
        "lifecycleStatus": {
          "enum": [
            "active",
            "inactive",
            "planned",
            "retired"
          ]
        }
      }
    },
    "consumerRegistryAuthorityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityEvidenceId",
        "provider",
        "evidenceRef",
        "scopeDigest",
        "registryVersion",
        "registryDigest",
        "membersDigest",
        "checkedAt",
        "verificationStatus",
        "runtimeEvidenceClaim"
      ],
      "properties": {
        "authorityEvidenceId": {
          "$ref": "#/$defs/uuidV7"
        },
        "provider": {
          "const": "consumer-registry-authority"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 33,
          "maxLength": 512,
          "pattern": "^consumer-registry-authority://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+(?![\\s\\S])"
        },
        "scopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "registryVersion": {
          "const": "QUALITY-SNAPSHOT-CONSUMER-REGISTRY-1.0.0"
        },
        "registryDigest": {
          "$ref": "#/$defs/digest"
        },
        "membersDigest": {
          "$ref": "#/$defs/digest"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verificationStatus": {
          "const": "verified"
        },
        "runtimeEvidenceClaim": {
          "const": "production-verified"
        }
      }
    },
    "consumerRegistryGuard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "registryVersion",
            "registryDigest",
            "members",
            "checkedAt",
            "authorityEvidence"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "registryVersion": {
              "const": "QUALITY-SNAPSHOT-CONSUMER-REGISTRY-1.0.0"
            },
            "registryDigest": {
              "$ref": "#/$defs/digest"
            },
            "members": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/registryMember"
              }
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time"
            },
            "authorityEvidence": {
              "$ref": "#/$defs/consumerRegistryAuthorityEvidence"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "registryVersion",
            "registryDigest",
            "members",
            "checkedAt",
            "authorityEvidence"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "registryVersion": {
              "const": "QUALITY-SNAPSHOT-CONSUMER-REGISTRY-1.0.0"
            },
            "registryDigest": {
              "$ref": "#/$defs/digest"
            },
            "members": {
              "type": "array",
              "maxItems": 0
            },
            "checkedAt": {
              "const": null
            },
            "authorityEvidence": {
              "const": null
            }
          }
        }
      ]
    },
    "consumerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "snapshotId",
        "snapshotImmutableHash",
        "requiredAggregateVersion",
        "consumerId",
        "registryVersion",
        "registryDigest",
        "scopeDigest",
        "attestedAt"
