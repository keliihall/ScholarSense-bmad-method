      "properties": {
        "consumerId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]{2,79}(?![\\s\\S])"
        },
        "registryMembership": {
          "enum": [
            "required-for-snapshot",
            "unreleased-reference-holder",
            "planned-never-held-reference"
          ]
        },
        "lifecycleStatus": {
          "enum": [
            "active",
            "inactive",
            "planned",
            "retired"
          ]
        },
        "watermarkStatus": {
          "enum": [
            "confirmed",
            "missing",
            "unknown"
          ]
        },
        "requiredAggregateVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "confirmedAggregateVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transportAck": {
          "enum": [
            "acked",
            "missing"
          ]
        },
        "inboxAck": {
          "enum": [
            "acked",
            "missing"
          ]
        },
        "evidenceCopyAck": {
          "enum": [
            "copied",
            "not-required",
            "missing",
            "unavailable"
          ]
        },
        "attestation": {
          "oneOf": [
            {
              "$ref": "#/$defs/consumerAttestation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustedTime",
        "legalHold",
        "consumerRegistry",
        "consumerWatermarksCheckedAt",
