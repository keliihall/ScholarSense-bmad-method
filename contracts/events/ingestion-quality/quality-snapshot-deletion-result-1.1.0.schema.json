        },
        "legalHold": {
          "$ref": "#/$defs/legalHoldGuard"
        },
        "consumerRegistry": {
          "$ref": "#/$defs/consumerRegistryGuard"
        },
        "consumerWatermarksCheckedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "consumerWatermarks": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/consumerWatermark"
          }
        }
      }
    },
