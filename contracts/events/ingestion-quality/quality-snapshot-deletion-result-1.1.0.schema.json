      "properties": {
        "kind": {
          "enum": [
            "evidence-copy",
            "zero-dependency-no-reference",
            "decommission-no-reference"
          ]
        },
        "snapshotId": {
          "$ref": "#/$defs/uuidV7"
        },
        "snapshotImmutableHash": {
          "$ref": "#/$defs/digest"
        },
        "requiredAggregateVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "consumerId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]{2,79}(?![\\s\\S])"
        },
        "registryVersion": {
          "const": "QUALITY-SNAPSHOT-CONSUMER-REGISTRY-1.0.0"
        },
        "registryDigest": {
          "$ref": "#/$defs/digest"
        },
        "scopeDigest": {
          "$ref": "#/$defs/digest"
        },
        "attestedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
