{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/events/ingestion-quality/data-batch-quality-event.schema.json",
  "title": "Self-contained assessed or published quality snapshot CloudEvent",
  "$defs": {
    "uuidV7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "nullableUuidV7": {"oneOf": [{"$ref": "#/$defs/uuidV7"}, {"type": "null"}]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["startAt", "endAt"],
      "properties": {"startAt": {"$ref": "#/$defs/timestamp"}, "endAt": {"$ref": "#/$defs/timestamp"}}
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["metricId", "formulaId", "formulaVersion", "result", "applicable", "numerator", "denominator", "valueBasisPoints", "unit", "operator", "thresholdNumerator", "thresholdDenominator", "boundary", "reasonCode"],
      "properties": {
        "metricId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
        "formulaId": {"type": "string", "pattern": "^QMDP-1\\.0\\.0/.{1,244}$"},
        "formulaVersion": {"const": "1.0.0"},
        "result": {"enum": ["passed", "failed", "not-applicable"]},
        "applicable": {"type": "boolean"},
        "numerator": {"$ref": "#/$defs/safeInteger"},
        "denominator": {"$ref": "#/$defs/safeInteger"},
        "valueBasisPoints": {"oneOf": [{"$ref": "#/$defs/safeInteger"}, {"type": "null"}]},
        "unit": {"enum": ["basis-point", "count", "millisecond", "member-count"]},
        "operator": {"enum": [">=", "<=", "="]},
        "thresholdNumerator": {"$ref": "#/$defs/safeInteger"},
        "thresholdDenominator": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "boundary": {"const": "inclusive"},
        "reasonCode": {"type": "null"}
      }
    },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["batchId", "sourceId", "sourceVersion", "status", "aggregateVersion", "manifestDigest", "observationWindow", "cutoffAt", "watermark", "sourceSchemaVersion", "sourceSchemaDigest", "qualityMetricDecisionProfileVersion", "qualityMetricDecisionProfileDigest", "qualityGateVersion", "qualityGateDigest", "lineageId", "supersedesBatchId", "effectiveAt", "evaluatedAt", "publishedAt"],
      "properties": {
        "batchId": {"$ref": "#/$defs/uuidV7"},
        "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}$"},
        "sourceVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "status": {"enum": ["quality-passed", "quality-failed", "published"]},
        "aggregateVersion": {"type": "integer", "minimum": 3, "maximum": 4},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "observationWindow": {"$ref": "#/$defs/window"},
        "cutoffAt": {"$ref": "#/$defs/timestamp"},
        "watermark": {"type": "string", "minLength": 1, "maxLength": 512},
        "sourceSchemaVersion": {"type": "string", "minLength": 1, "maxLength": 128},
        "sourceSchemaDigest": {"$ref": "#/$defs/digest"},
        "qualityMetricDecisionProfileVersion": {"const": "QMDP-1.0.0"},
        "qualityMetricDecisionProfileDigest": {"$ref": "#/$defs/digest"},
        "qualityGateVersion": {"const": "QG-1.0.0"},
        "qualityGateDigest": {"$ref": "#/$defs/digest"},
        "lineageId": {"$ref": "#/$defs/uuidV7"},
        "supersedesBatchId": {"$ref": "#/$defs/nullableUuidV7"},
        "effectiveAt": {"$ref": "#/$defs/timestamp"},
        "evaluatedAt": {"$ref": "#/$defs/timestamp"},
        "publishedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotId", "batchId", "sourceId", "assessedBatchStatus", "overallResult", "observationWindow", "cutoffAt", "evaluatedAt", "watermark", "metricResults", "impactScopeCodes", "sourceOwnerRef", "approvalRef", "effectiveAt", "retentionScheduleVersion", "qualityMetricDecisionProfileVersion", "qualityMetricDecisionProfileDigest", "qualityGateVersion", "qualityGateDigest", "canonicalizationProfile", "manifestDigest", "sourceSchemaVersion", "sourceSchemaDigest", "immutableHash", "traceId", "lineageId", "supersedesSnapshotId", "aggregateVersion"],
      "properties": {
        "snapshotId": {"$ref": "#/$defs/uuidV7"}, "batchId": {"$ref": "#/$defs/uuidV7"},
        "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}$"},
        "assessedBatchStatus": {"enum": ["quality-passed", "quality-failed"]},
        "overallResult": {"enum": ["quality-passed", "quality-failed"]},
        "observationWindow": {"$ref": "#/$defs/window"}, "cutoffAt": {"$ref": "#/$defs/timestamp"},
        "evaluatedAt": {"$ref": "#/$defs/timestamp"}, "watermark": {"type": "string", "minLength": 1, "maxLength": 512},
        "metricResults": {"type": "array", "minItems": 1, "maxItems": 14, "items": {"$ref": "#/$defs/metric"}},
        "impactScopeCodes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}},
        "sourceOwnerRef": {"type": "string", "minLength": 1, "maxLength": 256}, "approvalRef": {"const": "AUTH-2026-08-08-001"},
        "effectiveAt": {"$ref": "#/$defs/timestamp"}, "retentionScheduleVersion": {"const": "RS-1.0.0"},
        "qualityMetricDecisionProfileVersion": {"const": "QMDP-1.0.0"}, "qualityMetricDecisionProfileDigest": {"$ref": "#/$defs/digest"},
        "qualityGateVersion": {"const": "QG-1.0.0"}, "qualityGateDigest": {"$ref": "#/$defs/digest"},
        "canonicalizationProfile": {"const": "SCHOLARSENSE-CANONICAL-JSON-1.0.0"}, "manifestDigest": {"$ref": "#/$defs/digest"},
        "sourceSchemaVersion": {"type": "string", "minLength": 1, "maxLength": 128}, "sourceSchemaDigest": {"$ref": "#/$defs/digest"},
        "immutableHash": {"$ref": "#/$defs/digest"}, "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
        "lineageId": {"$ref": "#/$defs/uuidV7"}, "supersedesSnapshotId": {"$ref": "#/$defs/nullableUuidV7"},
        "aggregateVersion": {"const": 3}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["data", "datacontenttype", "id", "source", "specversion", "subject", "time", "traceparent", "type"],
  "properties": {
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["aggregateId", "aggregateType", "aggregateVersion", "causationId", "contractVersion", "correlationId", "eventId", "occurredAt", "producer", "runtimeEvidenceClaim", "schemaVersion", "traceId", "batch", "qualitySnapshot"],
      "properties": {
        "aggregateId": {"$ref": "#/$defs/uuidV7"}, "aggregateType": {"const": "data-batch"},
        "aggregateVersion": {"type": "integer", "minimum": 3, "maximum": 4}, "causationId": {"$ref": "#/$defs/uuidV7"},
        "contractVersion": {"const": "PIC-1.0.0"}, "correlationId": {"$ref": "#/$defs/uuidV7"}, "eventId": {"$ref": "#/$defs/uuidV7"},
        "occurredAt": {"$ref": "#/$defs/timestamp"}, "producer": {"const": "ingestion-quality"}, "runtimeEvidenceClaim": {"const": "none"},
        "schemaVersion": {"enum": ["DATA-BATCH-QUALITY-ASSESSED-1.0.0", "DATA-BATCH-PUBLISHED-1.0.0"]},
        "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"}, "batch": {"$ref": "#/$defs/batch"}, "qualitySnapshot": {"$ref": "#/$defs/snapshot"}
      }
    },
    "datacontenttype": {"const": "application/json"}, "id": {"$ref": "#/$defs/uuidV7"},
    "source": {"const": "urn:scholarsense:ingestion-quality"}, "specversion": {"const": "1.0"},
    "subject": {"type": "string", "pattern": "^data-batch/[0-9a-f-]{36}$"}, "time": {"$ref": "#/$defs/timestamp"},
    "traceparent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-01$"},
    "type": {"enum": ["scholarsense.ingestion-quality.data-batch.quality-assessed.v1", "scholarsense.ingestion-quality.data-batch.published.v1"]}
  }
}
