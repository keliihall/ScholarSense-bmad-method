{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/events/ingestion-quality/quality-eligibility-event.schema.json",
  "title": "QualityEligibility CloudEvent",
  "x-maximumWireBytes": 65536,
  "x-crossFieldBindings": [
    "id=data.eventId",
    "subject=quality-eligibility/{data.aggregateId}",
    "time=data.occurredAt=data.qualityEligibility.occurredAt",
    "data.aggregateId=data.qualityEligibility.eligibilityId",
    "data.aggregateVersion=data.qualityEligibility.aggregateVersion",
    "data.traceId=data.qualityEligibility.traceId=traceparent.trace-id"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "type", "source", "id", "subject", "time", "datacontenttype", "traceparent", "data"],
  "properties": {
    "specversion": {"const": "1.0"},
    "type": {"const": "scholarsense.ingestion-quality.quality-eligibility.changed.v1"},
    "source": {"const": "https://scholarsense.suda.edu.cn/ingestion-quality"},
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "subject": {"type": "string", "pattern": "^quality-eligibility/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "datacontenttype": {"const": "application/json"},
    "traceparent": {"type": "string", "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-01$"},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "aggregateId", "aggregateType", "aggregateVersion", "contractVersion", "schemaVersion", "occurredAt", "traceId", "producer", "runtimeEvidenceClaim", "qualityEligibility"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "aggregateId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "aggregateType": {"const": "QualityEligibility"}, "aggregateVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "contractVersion": {"const": "PIC-1.0.0"}, "schemaVersion": {"const": "QUALITY-ELIGIBILITY-EVENT-1.0.0"},
        "occurredAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}, "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"},
        "producer": {"const": "ingestion-quality"}, "runtimeEvidenceClaim": {"const": "none"},
        "qualityEligibility": {"$ref": "../../ingestion-quality/rule-dependency/quality-eligibility.schema.json"}
      }
    }
  }
}
