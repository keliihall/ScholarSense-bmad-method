{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.local/contracts/events/ingestion-quality/quality-fuse-task-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "source": {"const": "scholarsense/ingestion-quality"},
    "type": {"const": "scholarsense.ingestion-quality.quality-recovery-task.changed.v1"},
    "subject": {"type": "string", "pattern": "^quality-recovery-task/"},
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "taskId", "episodeId", "workItemKey", "operation", "routeSequence", "sourceAggregateVersion", "contractVersion", "task", "runtimeEvidenceClaim"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "taskId": {"type": "string", "format": "uuid"},
        "episodeId": {"type": "string", "format": "uuid"},
        "workItemKey": {"type": "string"},
        "operation": {"enum": ["create", "update"]},
        "routeSequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sourceAggregateVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "contractVersion": {"const": "PIC-1.1.0"},
        "task": {"$ref": "../../ingestion-quality/quality-fuse/recovery-task.schema.json"},
        "runtimeEvidenceClaim": {"const": "none"}
      }
    }
  },
  "x-maximumWireBytes": 65536,
  "x-crossFieldBindings": ["id=data.eventId", "subject=quality-recovery-task/data.taskId"]
}
