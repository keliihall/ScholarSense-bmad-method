{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholarsense:public-integration:command:1.0.0",
  "title": "PIC discriminated single-operation command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "channelId",
    "generationKey",
    "providerEffectKey",
    "operation",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "requestDigest",
    "traceId",
    "payload"
  ],
  "properties": {
    "contractVersion": {"const": "PIC-1.0.0"},
    "channelId": {"type": "string", "pattern": "^pic\\.[a-z0-9-]+\\.v1$"},
    "generationKey": {"type": "string", "pattern": "^g1\\.[A-Za-z0-9_-]{43}$"},
    "providerEffectKey": {"type": "string", "pattern": "^pe1\\.[A-Za-z0-9_-]{43}$"},
    "operation": {"enum": ["create", "update", "close", "revoke", "merge", "writeback", "publish"]},
    "aggregateType": {"type": "string", "minLength": 1, "maxLength": 64},
    "aggregateId": {"type": "string", "minLength": 1, "maxLength": 128},
    "aggregateVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "requestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["channelId", "operation", "payload"],
      "properties": {
        "channelId": {"const": "pic.public-task.v1"},
        "operation": {"enum": ["create", "update", "close", "revoke", "merge"]},
        "payload": {"$ref": "#/$defs/taskPayload"}
      }
    },
    {
      "type": "object",
      "required": ["channelId", "operation", "payload"],
      "properties": {
        "channelId": {"const": "pic.public-message.v1"},
        "operation": {"const": "create"},
        "payload": {"$ref": "#/$defs/messagePayload"}
      }
    },
    {
      "type": "object",
      "required": ["channelId", "operation", "payload"],
      "properties": {
        "channelId": {"const": "pic.status-result-writeback.v1"},
        "operation": {"const": "writeback"},
        "payload": {"$ref": "#/$defs/writebackPayload"}
      }
    },
    {
      "type": "object",
      "required": ["channelId", "operation", "payload"],
      "properties": {
        "channelId": {"const": "pic.external-transfer-work-order.v1"},
        "operation": {"enum": ["create", "update", "close", "revoke"]},
        "payload": {"$ref": "#/$defs/transferPayload"}
      }
    },
    {
      "type": "object",
      "required": ["channelId", "operation", "payload"],
      "properties": {
        "channelId": {"const": "pic.metric-publication.v1"},
        "operation": {"const": "publish"},
        "payload": {"$ref": "#/$defs/metricPayload"}
      }
    }
  ],
  "$defs": {
    "taskPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workItemKey", "itemType", "ownerRef", "priority", "progressState", "taskStatus", "deepLinkRouteId", "routeState"],
      "properties": {
        "workItemKey": {"type": "string", "minLength": 1, "maxLength": 128},
        "itemType": {"enum": ["candidate", "clue", "task"]},
        "ownerRef": {"type": "string", "minLength": 1, "maxLength": 128},
        "priority": {"enum": ["urgent", "normal"]},
        "dueAt": {"type": ["string", "null"], "format": "date-time"},
        "progressState": {"enum": ["pending", "in-progress", "waiting", "completed"]},
        "taskStatus": {"enum": ["open", "closed", "revoked", "merged"]},
        "deepLinkRouteId": {"enum": ["care-work-item", "transfer-work-order", "report-job"]},
        "routeState": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{1,256}$"}
      }
    },
    "messagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notificationType", "escalationVersion"],
      "properties": {
        "notificationType": {"enum": ["due", "overdue", "escalation", "responsibility-changed"]},
        "escalationVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "writebackPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localAggregateId", "localAggregateVersion", "eventId", "status", "occurredAt", "resultCategory", "correlationId", "causationId"],
      "properties": {
        "localAggregateId": {"type": "string", "minLength": 1, "maxLength": 128},
        "localAggregateVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "eventId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "status": {"enum": ["accepted", "confirmed", "failed", "rejected"]},
        "occurredAt": {"type": "string", "format": "date-time"},
        "resultCategory": {"enum": ["accepted", "completed", "supplement-required", "rejected", "failed"]},
        "correlationId": {"type": "string", "minLength": 1, "maxLength": 128},
        "causationId": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "transferPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workItemKey", "itemType", "ownerRef", "priority", "progressState", "taskStatus", "deepLinkRouteId", "routeState"],
      "properties": {
        "workItemKey": {"type": "string", "minLength": 1, "maxLength": 128},
        "itemType": {"const": "transfer"},
        "ownerRef": {"type": "string", "minLength": 1, "maxLength": 128},
        "priority": {"enum": ["urgent", "normal"]},
        "dueAt": {"type": ["string", "null"], "format": "date-time"},
        "progressState": {"enum": ["pending", "in-progress", "waiting", "completed"]},
        "taskStatus": {"enum": ["open", "closed", "revoked"]},
        "deepLinkRouteId": {"const": "transfer-work-order"},
        "routeState": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{1,256}$"}
      }
    },
    "metricPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "metricVersion", "suppressed"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "denominator": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "metricVersion": {"type": "string", "pattern": "^MPP-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "suppressed": {"type": "boolean"}
      }
    }
  }
}
