{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/data-catalog/data-source-catalog-1.1.0.schema.json",
  "title": "DataSourceCatalogSuccessor",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "qualityGateVersion", "effectiveAt", "accountableOwner", "schemaEvolution", "sources"],
  "properties": {
    "contractVersion": {"const": "DCC-1.1.0"},
    "qualityGateVersion": {"const": "QG-1.0.0"},
    "effectiveAt": {"const": "2026-08-09T12:00:59+08:00"},
    "accountableOwner": {"type": "string", "minLength": 2},
    "schemaEvolution": {"const": "successor-only-no-in-place-mutation"},
    "sources": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceDescriptor"}
    }
  },
  "$defs": {
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId", "ownerDepartment", "ownerName", "responsibleRole", "businessDefinition",
        "purpose", "businessKeys", "effectiveInterval", "updateFrequency", "slo", "coverage",
        "sensitivity", "schemaRef", "schemaVersion", "qualityGateVersion", "reconciliation",
        "backfill", "contractTests", "evidenceUri", "runtimeEvidenceClaim", "consumerMode", "status"
      ],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}$"},
        "ownerDepartment": {"type": "string", "minLength": 2},
        "ownerName": {"type": "string", "minLength": 2},
        "responsibleRole": {"type": "string", "minLength": 2},
        "businessDefinition": {"type": "string", "minLength": 4},
        "purpose": {"type": "string", "minLength": 3},
        "businessKeys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effectiveInterval": {"const": "half-open-utc"},
        "updateFrequency": {"type": "string", "minLength": 2},
        "slo": {"type": "string", "minLength": 2},
        "coverage": {"type": "string", "minLength": 2},
        "sensitivity": {"enum": ["internal", "sensitive", "highly-sensitive-deidentified"]},
        "schemaRef": {"type": "string", "pattern": "^sources/[a-z0-9.-]+\\.schema\\.json$"},
        "schemaVersion": {"type": "string", "pattern": "^[A-Z0-9-]+-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "qualityGateVersion": {"const": "QG-1.0.0"},
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schedule", "minimumBasisPoints"],
          "properties": {
            "schedule": {"type": "string", "minLength": 2},
            "minimumBasisPoints": {"type": "integer", "minimum": 0, "maximum": 10000}
          }
        },
        "backfill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windowDays", "watermarkRequired"],
          "properties": {
            "windowDays": {"type": "integer", "minimum": 1},
            "watermarkRequired": {"type": "boolean"}
          }
        },
        "contractTests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidenceUri": {
          "type": "string",
          "pattern": "^(?:evidence://pending/SRC-P[01]-[A-Z-]+-[0-9]{3}|(?:sha256|evidence\\+sha256)://[0-9a-f]{64}(?:#source=SRC-P[01]-[A-Z-]+-[0-9]{3})?|oci://ghcr\\.io/[a-z0-9_.-]+/[a-z0-9_./-]+@sha256:[0-9a-f]{64}|s3-version://[a-z0-9][a-z0-9.-]{1,62}/[^?#]+\\?versionId=[A-Za-z0-9._~-]{8,})$"
        },
        "runtimeEvidenceClaim": {"enum": ["none", "target-verified"]},
        "consumerMode": {"enum": ["rule-dependency", "purpose-isolated"]},
        "status": {"enum": ["approved-contract", "retired"]}
      }
    }
  }
}
