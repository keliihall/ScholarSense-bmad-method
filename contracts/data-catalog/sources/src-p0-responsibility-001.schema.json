{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://scholarsense.suda.edu.cn/contracts/data-catalog/sources/src-p0-responsibility-001.schema.json",
  "title":"Responsibility authority v2 controlled reference",
  "type":"object",
  "additionalProperties":false,
  "required":["responsibilityAuthorityContractVersion","relationEvidenceRef","sourceVersion","sourceWatermark"],
  "properties":{
    "responsibilityAuthorityContractVersion":{"const":"RESPONSIBILITY-AUTHORITY-V2-2.0.0"},
    "relationEvidenceRef":{"type":"string","pattern":"^evidence-ref:[A-Za-z0-9._-]{8,160}$"},
    "sourceVersion":{"type":"integer","minimum":1},
    "sourceWatermark":{"type":"string"}
  }
}
