{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/data-catalog/data-catalog-target-report.schema.json",
  "title": "DataCatalogTargetReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportVersion", "contractVersion", "qualityGateVersion", "authority",
    "environment", "candidateCommit", "candidateTree", "handoffRevision",
    "handoffDigest", "catalogDigest", "qualityGateDigest", "sourceCount",
    "sources", "privacy", "occurredAt", "runtimeEvidenceClaim", "result",
    "evidenceDigest"
  ],
  "properties": {
    "reportVersion": {"const": "DCC-TARGET-REPORT-1.0.0"},
    "contractVersion": {"const": "DCC-1.0.0"},
    "qualityGateVersion": {"const": "QG-1.0.0"},
    "authority": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "environment": {"enum": ["test", "stage", "prod"]},
    "candidateCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidateTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "handoffRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "handoffDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "catalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "qualityGateDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceCount": {"const": 17},
    "sources": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceEvidence"}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studentPlaintextStored", "rawBodyStored"],
      "properties": {
        "studentPlaintextStored": {"const": false},
        "rawBodyStored": {"const": false}
      }
    },
    "occurredAt": {"type": "string", "format": "date-time"},
    "runtimeEvidenceClaim": {"const": "target-verified"},
    "result": {"const": "pass"},
    "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "observationDigest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,127}$"},
        "result": {"const": "pass"},
        "observationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId", "contractVersion", "schemaVersion", "qualityGateVersion",
        "environment", "authority", "candidateCommit", "candidateTree",
        "handoffRevision", "handoffDigest", "inputDigest", "scenarios",
        "result", "occurredAt", "signatureDigest", "evidenceDigest",
        "cleanupResult", "runtimeEvidenceClaim"
      ],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}$"},
        "contractVersion": {"const": "DCC-1.0.0"},
        "schemaVersion": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "qualityGateVersion": {"const": "QG-1.0.0"},
        "environment": {"enum": ["test", "stage", "prod"]},
        "authority": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
        "candidateCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidateTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "handoffRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "handoffDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scenario"}
        },
        "result": {"const": "pass"},
        "occurredAt": {"type": "string", "format": "date-time"},
        "signatureDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "cleanupResult": {"const": "pass"},
        "runtimeEvidenceClaim": {"const": "target-verified"}
      }
    }
  }
}
