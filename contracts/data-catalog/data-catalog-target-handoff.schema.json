{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/data-catalog/data-catalog-target-handoff.schema.json",
  "title": "DataCatalogTargetHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoffVersion", "authority", "environment", "approvedSchemes", "approvedHosts", "approvedIpCidrs", "sourceEndpoints", "expectedCatalogDigest", "candidateCommit", "candidateTree", "revision", "issuedAt", "expiresAt", "signature"],
  "properties": {
    "handoffVersion": {"const": "DCC-TARGET-HANDOFF-1.0.0"}, "authority": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"}, "environment": {"enum": ["test", "stage", "prod"]}, "approvedSchemes": {"type": "array", "items": {"const": "https"}, "minItems": 1, "maxItems": 1, "uniqueItems": true}, "approvedHosts": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}, "minItems": 1, "uniqueItems": true}, "approvedIpCidrs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "sourceEndpoints": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^https://"}}, "expectedCatalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "candidateCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "candidateTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "signature": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
