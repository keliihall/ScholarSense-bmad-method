{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/data-catalog/data-catalog-runtime-evidence.schema.json",
  "title": "DataCatalogRuntimeEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId", "contractVersion", "schemaVersion", "qualityGateVersion", "environment", "authority", "candidateCommit", "candidateTree", "inputDigest", "scenarios", "result", "occurredAt", "signatureDigest", "evidenceDigest", "cleanupResult", "runtimeEvidenceClaim"],
  "properties": {
    "sourceId": {"type": "string"}, "contractVersion": {"const": "DCC-1.0.0"}, "schemaVersion": {"type": "string"}, "qualityGateVersion": {"const": "QG-1.0.0"}, "environment": {"enum": ["test", "stage", "prod"]}, "authority": {"type": "string"}, "candidateCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "candidateTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "scenarios": {"type": "array", "minItems": 1}, "result": {"enum": ["pass", "fail", "skip", "unsupported"]}, "occurredAt": {"type": "string", "format": "date-time"}, "signatureDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "evidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "cleanupResult": {"const": "pass"}, "runtimeEvidenceClaim": {"enum": ["target-verified", "none"]}
  }
}
