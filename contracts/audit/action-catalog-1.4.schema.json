{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/audit/action-catalog-1.4.schema.json",
  "title": "ScholarSense authorization audit action successor delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "supersedes", "mode", "outcomes", "reasonCodes", "actions"],
  "properties": {
    "$schema": {"const": "./action-catalog-1.4.schema.json"},
    "version": {"const": "AUDIT-ACTION-CATALOG-1.4.0"},
    "supersedes": {"const": "AUDIT-ACTION-CATALOG-1.3.0"},
    "mode": {"const": "successor-delta"},
    "outcomes": {"const": ["accepted", "rejected"]},
    "reasonCodes": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": {"pattern": "^AUTHORIZATION_[A-Z0-9_]+$"}
    },
    "actions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "ownerModule", "activationStory", "status", "allowedOutcomes", "allowedReasonCodes", "allowedResults"],
        "properties": {
          "code": {"enum": ["authorization.object.decided", "authorization.shell.viewed", "authorization.decision.rechecked"]},
          "ownerModule": {"const": "identity-access"},
          "activationStory": {"const": "1-7"},
          "status": {"const": "active"},
          "allowedOutcomes": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["accepted", "rejected"]}},
          "allowedReasonCodes": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"pattern": "^AUTHORIZATION_[A-Z0-9_]+$"}},
          "allowedResults": {
            "type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["outcome", "reasonCode"],
              "properties": {"outcome": {"enum": ["accepted", "rejected"]}, "reasonCode": {"pattern": "^AUTHORIZATION_[A-Z0-9_]+$"}}
            }
          }
        }
      }
    }
  }
}
