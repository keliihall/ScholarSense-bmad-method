{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/audit/action-catalog-1.3.schema.json",
  "title": "ScholarSense access invalidation audit action successor delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "supersedes", "mode", "outcomes", "reasonCodes", "actions"],
  "properties": {
    "$schema": {"const": "./action-catalog-1.3.schema.json"},
    "version": {"const": "AUDIT-ACTION-CATALOG-1.3.0"},
    "supersedes": {"const": "AUDIT-ACTION-CATALOG-1.2.0"},
    "mode": {"const": "successor-delta"},
    "outcomes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["accepted", "rejected"]}
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "pattern": "^(?:ACCESS_INVALIDATION|RESPONSIBILITY)_[A-Z0-9_]+$"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code", "ownerModule", "activationStory", "status",
          "allowedOutcomes", "allowedReasonCodes", "allowedResults"
        ],
        "properties": {
          "code": {
            "enum": [
              "access.invalidation.published",
              "responsibility.sync.rejected",
              "responsibility.v2.activated",
              "responsibility.v2.cutover.denied",
              "responsibility.v2.cutover.failed",
              "responsibility.v2.cutover.requested",
              "responsibility.v2.reconciled"
            ]
          },
          "ownerModule": {"const": "identity-access"},
          "activationStory": {"const": "1-6c"},
          "status": {"const": "active"},
          "allowedOutcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["accepted", "rejected"]}
          },
          "allowedReasonCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "pattern": "^(?:ACCESS_INVALIDATION|RESPONSIBILITY)_[A-Z0-9_]+$"
            }
          },
          "allowedResults": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "reasonCode"],
              "properties": {
                "outcome": {"enum": ["accepted", "rejected"]},
                "reasonCode": {
                  "pattern": "^(?:ACCESS_INVALIDATION|RESPONSIBILITY)_[A-Z0-9_]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
