{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/responsibility-authority/full-snapshot.schema.json",
  "title": "Signed sealed responsibility full snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "sourceId",
    "feedId",
    "consumerProjection",
    "snapshotId",
    "businessDate",
    "cutoffAt",
    "sourceVersion",
    "throughWatermark",
    "supportingIdentityOrgWatermarks",
    "sealed",
    "complete",
    "expectedCount",
    "canonicalDigest",
    "signatureDigest",
    "partitions",
    "records",
    "traceId"
  ],
  "properties": {
    "$schema": {"const": "../../full-snapshot.schema.json"},
    "schemaVersion": {"const": "RESPONSIBILITY-SNAPSHOT-1.0.0"},
    "contractVersion": {"const": "RESPONSIBILITY-AUTHORITY-1.0.0"},
    "sourceId": {"const": "SRC-P0-RESPONSIBILITY-001"},
    "feedId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "consumerProjection": {"const": "responsibility"},
    "snapshotId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "businessDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "cutoffAt": {"type": "string", "format": "date-time"},
    "sourceVersion": {"type": "integer", "minimum": 1},
    "throughWatermark": {"type": "integer", "minimum": 0},
    "supportingIdentityOrgWatermarks": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "sealed": {"const": true},
    "complete": {"const": true},
    "expectedCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "canonicalDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signatureDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "partitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
    },
    "records": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationRefToken",
          "studentEquivalenceDomain",
          "recordVersion",
          "payloadDigest"
        ],
        "properties": {
          "relationRefToken": {
            "type": "string",
            "pattern": "^rtok_[A-Za-z0-9_-]{32,128}$"
          },
          "studentEquivalenceDomain": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "recordVersion": {"type": "integer", "minimum": 1},
          "payloadDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
