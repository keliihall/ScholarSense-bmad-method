{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/responsibility-authority/incremental-batch.schema.json",
  "title": "Responsibility incremental batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "sourceId",
    "feedId",
    "partitionId",
    "consumerProjection",
    "batchId",
    "sourceVersion",
    "fromWatermark",
    "toWatermark",
    "supportingIdentityOrgWatermarks",
    "sourceVisibleAt",
    "observedAt",
    "traceId",
    "correlationId",
    "signatureDigest",
    "records"
  ],
  "properties": {
    "$schema": {"const": "../../incremental-batch.schema.json"},
    "schemaVersion": {"const": "RESPONSIBILITY-BATCH-1.0.0"},
    "contractVersion": {"const": "RESPONSIBILITY-AUTHORITY-1.0.0"},
    "sourceId": {"const": "SRC-P0-RESPONSIBILITY-001"},
    "feedId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "partitionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "consumerProjection": {"const": "responsibility"},
    "batchId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "sourceVersion": {"type": "integer", "minimum": 1},
    "fromWatermark": {"type": "integer", "minimum": 0},
    "toWatermark": {"type": "integer", "minimum": 1},
    "supportingIdentityOrgWatermarks": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "sourceVisibleAt": {"type": "string", "format": "date-time"},
    "observedAt": {"type": "string", "format": "date-time"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "correlationId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "signatureDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "payload"],
        "properties": {
          "eventId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
          "payload": {"type": "object"}
        }
      }
    }
  }
}
