{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/responsibility-authority/reconciliation-result.schema.json",
  "title": "Responsibility reconciliation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "runId",
    "sourceId",
    "consumerProjection",
    "contractVersion",
    "businessDate",
    "sourceVersion",
    "throughWatermark",
    "supportingIdentityOrgWatermarks",
    "expectedCount",
    "actualCount",
    "expectedDigest",
    "actualDigest",
    "matched",
    "missing",
    "unexpected",
    "versionDrift",
    "matchRate",
    "activeUnmappedCount",
    "exceptionCount",
    "jobOutcome",
    "reconciliationOutcome",
    "reasonCode",
    "startedAt",
    "completedAt",
    "traceId"
  ],
  "properties": {
    "$schema": {"const": "../../reconciliation-result.schema.json"},
    "runId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "sourceId": {"const": "SRC-P0-RESPONSIBILITY-001"},
    "consumerProjection": {"const": "responsibility"},
    "contractVersion": {"const": "RESPONSIBILITY-AUTHORITY-1.0.0"},
    "businessDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sourceVersion": {"type": "integer", "minimum": 1},
    "throughWatermark": {"type": "integer", "minimum": 0},
    "supportingIdentityOrgWatermarks": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "expectedCount": {"type": "integer", "minimum": 0},
    "actualCount": {"type": "integer", "minimum": 0},
    "expectedDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "actualDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "matched": {"type": "integer", "minimum": 0},
    "missing": {"type": "integer", "minimum": 0},
    "unexpected": {"type": "integer", "minimum": 0},
    "versionDrift": {"type": "integer", "minimum": 0},
    "matchRate": {"type": "string", "pattern": "^(1\\.000000|0\\.[0-9]{6})$"},
    "activeUnmappedCount": {"type": "integer", "minimum": 0},
    "exceptionCount": {"type": "integer", "minimum": 0},
    "jobOutcome": {"type": "string", "enum": ["succeeded", "failed", "missed"]},
    "reconciliationOutcome": {"type": "string", "enum": ["matched", "differences-found", "threshold-failed"]},
    "reasonCode": {"type": "string", "pattern": "^RESPONSIBILITY_[A-Z0-9_]+$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
