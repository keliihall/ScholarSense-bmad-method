{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/subject-registry/mapping-recompute-job.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "status", "attemptNo", "fencingToken", "queuedAt", "traceId"],
  "properties": {
    "jobId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "status": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
    "attemptNo": {"type": "integer", "minimum": 0},
    "fencingToken": {"type": "integer", "minimum": 0},
    "queuedAt": {"type": "string", "format": "date-time"},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "resultCode": {"type": ["string", "null"], "maxLength": 64},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
