{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/subject-registry/mapping-recompute-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "correctionLineageId", "studentRef", "ruleId", "ruleVersion", "scenarioId", "windowId", "inputWatermarksDigest", "latestActionableAt", "requestedAt", "traceId"],
  "properties": {
    "requestId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "correctionLineageId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "studentRef": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "ruleId": {"type": "string", "minLength": 1},
    "ruleVersion": {"type": "string", "minLength": 1},
    "scenarioId": {"type": "string", "minLength": 1},
    "windowId": {"type": "string", "minLength": 1},
    "inputWatermarksDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "latestActionableAt": {"type": "string", "format": "date-time"},
    "requestedAt": {"type": "string", "format": "date-time"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
