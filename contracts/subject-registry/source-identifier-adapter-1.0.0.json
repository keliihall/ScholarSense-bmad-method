{
  "$schema": "source-identifier-adapter.schema.json",
  "contractVersion": "SUBJECT-IDENTIFIER-ADAPTER-1.0.0",
  "successorMode": "pre-normalization-sidecar",
  "preserves": ["DCC-1.0.0", "all-source-schema-1.0.0-digests"],
  "required": ["sourceId", "sourceContractVersion", "identifierType", "sourceNativeIdentifier", "authoritativeStudentNumber", "effectiveFrom", "effectiveTo", "sourceVersion", "sourceWatermark"],
  "properties": {
    "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}$"},
    "sourceContractVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "identifierType": {"type": "string", "minLength": 1, "maxLength": 64},
    "sourceNativeIdentifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "authoritativeStudentNumber": {"type": "string", "minLength": 6, "maxLength": 32, "pattern": "^[A-Za-z0-9]+$"},
    "effectiveFrom": {"type": "string", "format": "date-time"},
    "effectiveTo": {"type": ["string", "null"], "format": "date-time"},
    "sourceVersion": {"type": "integer", "minimum": 1},
    "sourceWatermark": {"type": "string", "minLength": 1, "maxLength": 128},
    "supersedesVersion": {"type": ["integer", "null"], "minimum": 1}
  }
}
