{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/subject-registry/historical-window.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectRef", "windowId", "startAt", "endAt", "timezone", "sourceVersions", "sourceWatermarks", "mappingVersion", "qualityGateVersions", "ruleId", "ruleVersion", "lineageRunId", "inputDigest", "latestActionableAt"],
  "properties": {
    "subjectRef": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "windowId": {"type": "string", "minLength": 1, "maxLength": 128},
    "startAt": {"type": "string", "format": "date-time"},
    "endAt": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Asia/Shanghai"},
    "sourceVersions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "sourceWatermarks": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "mappingVersion": {"type": "integer", "minimum": 1},
    "qualityGateVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "ruleId": {"type": "string", "minLength": 1},
    "ruleVersion": {"type": "string", "minLength": 1},
    "scenarioId": {"type": ["string", "null"]},
    "lineageRunId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "latestActionableAt": {"type": "string", "format": "date-time"}
  }
}
