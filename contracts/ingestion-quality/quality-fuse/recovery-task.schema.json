{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.local/contracts/ingestion-quality/quality-fuse/recovery-task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId", "workItemKey", "episodeId", "episodeGeneration", "sourceId", "dependencyId",
    "trigger", "affectedRules", "ownerRef", "priority", "dueAt", "status",
    "currentEvidence", "watermark", "aggregateVersion", "createdAt", "updatedAt"
  ],
  "properties": {
    "taskId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "workItemKey": {"type": "string", "pattern": "^qf:[A-Za-z0-9._:-]{16,180}$"},
    "episodeId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "episodeGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z0-9-]+-[0-9]{3}$"},
    "dependencyId": {"type": "string", "pattern": "^DEP-P[01]-[A-Z0-9-]+-[0-9]{3}$"},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "snapshotId", "reasonCode"],
      "properties": {
        "batchId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "snapshotId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "reasonCode": {"enum": ["REQUIRED_MEMBER_FAILED", "COMPOSITION_THRESHOLD_FAILED"]}
      }
    },
    "affectedRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}@[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$"
      }
    },
    "ownerRef": {"type": "string", "minLength": 1, "maxLength": 256},
    "priority": {"enum": ["P0", "P1", "P2"]},
    "dueAt": {"type": "string", "format": "date-time"},
    "status": {"const": "open"},
    "currentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualityGateVersion", "qmdpVersion", "qshmVersion"],
      "properties": {
        "qualityGateVersion": {"const": "QG-1.0.0"},
        "qmdpVersion": {"const": "QMDP-1.0.0"},
        "qshmVersion": {"const": "QSHM-1.0.0"}
      }
    },
    "watermark": {"type": "string", "minLength": 1, "maxLength": 512},
    "aggregateVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
