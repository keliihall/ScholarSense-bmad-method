  "legalHoldScopeBinding": {
    "checkedScopeDigestField": "guards.legalHold.checkedScopeDigest",
    "mustEqualField": "scope.scopeDigest",
    "clearStillBindsCurrentScope": true,
    "matchedRequiresCurrentScopeAndExactCount": true
  },
  "eventChronology": {
    "committedOrdering": "retentionDueAt<=guardChecks<=deletionCommittedAt<=occurredAt",
    "noCommitOrdering": "retentionDueAt<=guardChecks<=occurredAt",
    "guardCheckFields": [
      "guards.trustedTime.observedAt",
      "guards.legalHold.checkedAt",
      "guards.consumerRegistry.checkedAt",
      "guards.consumerWatermarksCheckedAt"
    ],
    "attestationUpperBound": "deletionCommittedAt-when-present-otherwise-occurredAt",
    "availableCheckTimeRequired": true
  },
  "eligibility": {
    "trustedTimeRequired": true,
    "dueComparison": "trustedNow>=retentionDueAt",
    "legalHoldWindow": "[startAt,endAt)",
    "consumerDenominator": "required-for-snapshot-plus-unreleased-reference-holders",
    "consumerRegistryVersionField": "guards.consumerRegistry.registryVersion",
    "consumerRegistryDigestField": "guards.consumerRegistry.registryDigest",
    "inactiveExitRule": "decommission-no-reference-attestation-required",
    "plannedExclusionRule": "planned-and-never-held-reference",
    "watermarkRule": "confirmedAggregateVersion>=requiredAggregateVersion",
    "watermarkEqualitySatisfies": true,
    "watermarkBlockingStates": [
      "behind",
      "missing",
      "unknown",
      "registry-unavailable"
    ],
    "watermarkDoesNotReplaceAttestation": true,
    "evidenceCopyAckRequired": true,
    "evidenceCopyAckSatisfyingValues": [
      "copied",
      "not-required"
    ],
    "notRequiredAttestationBinding": [
      "snapshotId",
      "snapshotImmutableHash",
      "requiredAggregateVersion"
    ],
    "transportAckCountsAsEvidenceCopyAck": false,
    "inboxAckCountsAsEvidenceCopyAck": false,
    "dependencyUnavailableResult": "blocked"
  },
  "downstreamEvidence": {
    "ownerModule": "clue-care",
    "ownerStories": [
      "3.4",
      "3.5"
    ],
    "objectType": "EvidenceSnapshot",
    "copyTriggers": [
      "candidate-create",
      "clue-create"
