    "runtimeEvidenceClaim": "none"
  },
  "ownerResult": {
    "eventType": "scholarsense.ingestion-quality.quality-snapshot.deletion-result.v1",
    "payloadContractVersion": "PIC-1.0.0",
    "outcomes": [
      "completed",
      "blocked",
      "partial",
      "failed"
    ],
    "wireSizeLimitBytes": 65536,
    "wireEncoding": "UTF-8",
    "wireMeasurement": "received-raw-utf8-bytes-before-json-parse",
    "byteOrderMarkAllowed": false,
    "wireJsonParser": "strict-duplicate-key-rejecting",
    "wirePrettyJsonAllowed": true,
    "wireCanonicalByteEqualityRequired": false,
    "blockedCompletionRule": "direct-successor-same-aggregate",
    "idempotencyIdentity": "eventId",
    "sameIdentitySamePayload": "duplicate",
    "sameIdentityDifferentPayload": "conflict",
    "lineageRootRule": "aggregateVersion=1-and-supersedesResultId=null",
    "lineageSuccessorRule": "aggregateVersion=predecessor.aggregateVersion+1-and-supersedesResultId=predecessor.eventId",
    "lineageScopeRule": "same-aggregate-and-same-scope",
    "lineageChronologyRule": "successor-evidence-at-or-after-predecessor-occurredAt",
    "lineageForkAllowed": false,
    "completedSupersessionAllowed": false,
    "ownerResultIsFinalReceipt": false,
    "databaseTransactionDigestBinding": {
      "semantics": "contract-binding-only",
      "algorithm": "sha256-canonical-json",
      "canonicalizationProfile": "SCHOLARSENSE-CANONICAL-JSON-1.0.0",
      "materialFields": [
        "executionId",
        "scopeDigest",
        "result",
        "deletionCommittedAt",
        "transactionId",
        "onlineSnapshot",
        "onlineMetrics"
      ],
      "targetMaterialFields": [
        "status",
        "selectedCount",
        "deletedCount",
        "remainingCount",
        "evidenceDigest",
        "errorCode"
      ],
      "digestFields": [
        "ownerLocalResults.onlineSnapshot.transactionEvidenceDigest",
        "ownerLocalResults.onlineMetrics.transactionEvidenceDigest"
      ],
      "databaseCommitProof": false,
      "runtimeEvidenceClaim": "none",
      "productionAtomicityEvidenceTasks": [
        "Task 3",
        "Task 7"
      ]
    }
  },
  "backup": {
    "policyVersion": "DRP-1.0.0",
    "maximumRetentionPeriod": "P35D",
    "maximumRetentionDays": 35,
    "dueWindow": "deletionCommittedAt<=backupExpiryDueAt<=deletionCommittedAt+P35D",
