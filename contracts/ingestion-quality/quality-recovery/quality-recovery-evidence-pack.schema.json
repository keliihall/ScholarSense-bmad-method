{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/ingestion-quality/quality-recovery/quality-recovery-evidence-pack.schema.json",
  "title": "Immutable self-contained quality recovery evidence pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidencePackId",
    "evidencePackVersion",
    "object",
    "policy",
    "sourceClass",
    "sourceSchemaVersion",
    "sourceSchemaDigest",
    "dependencyVersion",
    "dependencyDigest",
    "qualityEvidence",
    "batchEvidence",
    "backfillEvidence",
    "reconciliationEvidence",
    "sampleEvidence",
    "previewDigest",
    "readinessDecision",
    "missingEvidenceCodes",
    "trustedStartedAt",
    "trustedCompletedAt",
    "evidencePackDigest",
    "traceId",
    "canonicalizationProfile",
    "runtimeEvidenceClaim"
  ],
  "properties": {
    "schemaVersion": {"const": "QUALITY-RECOVERY-EVIDENCE-PACK-1.0.0"},
    "evidencePackId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "evidencePackVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "object": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/recoveryObjectBinding"},
    "policy": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/recoveryPolicyBinding"},
    "sourceClass": {"enum": ["streaming", "dailyBatch"]},
    "sourceSchemaVersion": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sourceSchemaDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "dependencyVersion": {"type": "string", "pattern": "^[1-9][0-9]{0,15}$"},
    "dependencyDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "qualityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotIdsDigest", "snapshotHashesDigest", "metricResultsDigest", "allRequiredMetricsPassed", "sourceWatermark", "dependencyWatermark"],
      "properties": {
        "snapshotIdsDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "snapshotHashesDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "metricResultsDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "allRequiredMetricsPassed": {"type": "boolean"},
        "sourceWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "dependencyWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"}
      }
    },
    "batchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequenceEvidenceVersion", "sequenceEvidenceDigest", "requiredConsecutivePassedBatches", "actualConsecutivePassedBatches", "qualified"],
      "properties": {
        "sequenceEvidenceVersion": {"const": "QUALITY-RECOVERY-BATCH-SEQUENCE-1.0.0"},
        "sequenceEvidenceDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "requiredConsecutivePassedBatches": {"enum": [2, 3]},
        "actualConsecutivePassedBatches": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "qualified": {"type": "boolean"}
      }
    },
    "backfillEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastKnownGoodWatermark", "trustedNow", "lookbackDays", "backfillStartWatermark", "backfillCompletedWatermark", "evidenceDigest", "status"],
      "properties": {
        "lastKnownGoodWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "trustedNow": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
        "lookbackDays": {"const": 90},
        "backfillStartWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "backfillCompletedWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "evidenceDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "status": {"enum": ["succeeded", "failed", "unavailable"]}
      }
    },
    "reconciliationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summaryVersion", "coverage", "expectedCount", "actualCount", "mismatchCount", "summaryDigest", "completedAt"],
      "properties": {
        "summaryVersion": {"const": "QUALITY-RECOVERY-RECONCILIATION-SUMMARY-1.0.0"},
        "coverage": {"const": "full"},
        "expectedCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "actualCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "mismatchCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "summaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "completedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"}
      }
    },
    "sampleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summaryVersion", "providerVersion", "providerAvailability", "selectionSeed", "populationCount", "selectedCount", "strata", "strataSummaryDigest", "expectedDigest", "actualDigest", "mismatchCount", "completedAt"],
      "properties": {
        "summaryVersion": {"const": "QUALITY-RECOVERY-SAMPLE-SUMMARY-1.0.0"},
        "providerVersion": {"type": "string", "pattern": "^RECOVERY-SAMPLE-PROVIDER-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "providerAvailability": {"enum": ["available", "unavailable", "not-installed"]},
        "selectionSeed": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "populationCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "selectedCount": {"type": "integer", "minimum": 0, "maximum": 10000},
        "strata": {"type": "array", "maxItems": 128, "items": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/stratumSummary"}},
        "strataSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "expectedDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "actualDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "mismatchCount": {"type": "integer", "minimum": 0, "maximum": 10000},
        "completedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"}
      }
    },
    "previewDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "readinessDecision": {"enum": ["ready-for-d4", "not-ready"]},
    "missingEvidenceCodes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "QUALITY_GATE_NOT_PASSED",
          "CONSECUTIVE_BATCHES_INSUFFICIENT",
          "BACKFILL_INCOMPLETE",
          "RECONCILIATION_MISMATCH",
          "SAMPLE_INSUFFICIENT",
          "SAMPLE_MISMATCH",
          "SAMPLE_PROVIDER_UNAVAILABLE",
          "REQUIRED_DEPENDENCY_NOT_ELIGIBLE",
          "ACTIVE_EPISODE_MISSING",
          "OPEN_RECOVERY_TASK_MISSING",
          "VERSION_OR_DIGEST_UNKNOWN"
        ]
      }
    },
    "trustedStartedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
    "trustedCompletedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
    "evidencePackDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "traceId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/traceId"},
    "canonicalizationProfile": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/canonicalizationProfile"},
    "runtimeEvidenceClaim": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/runtimeEvidenceClaim"}
  },
  "x-crossFieldBindings": [
    "evidencePackDigest covers the complete immutable pack except runtimeEvidenceClaim",
    "ready-for-d4 requires all required quality evidence, exact batch threshold, full reconciliation mismatchCount=0, available provider, QRP sample count and sample mismatchCount=0",
    "the pack is self-contained and must never be rebuilt by reading latest facts",
    "student identifiers, subject/window identifiers, raw rows, raw metric payloads and free text are forbidden"
  ],
  "x-maximumWireBytes": 262144
}
