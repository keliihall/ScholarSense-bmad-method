{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/ingestion-quality/quality-recovery/quality-recovery-validation-result-1.1.0.schema.json",
  "title": "Immutable quality recovery validation result with executable QRP readiness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "resultId", "jobId", "jobVersion", "recoveryRequestId",
    "episodeId", "taskId", "state", "targetState", "transitionApplied",
    "inputDigest", "qualityRecoveryPolicyVersion", "qualityRecoveryPolicyDigest",
    "backfillStartWatermarkDigest", "backfillTargetWatermarkDigest",
    "backfillSummaryDigest", "reconciliationExpectedCount",
    "reconciliationActualCount", "reconciliationMismatchCount",
    "reconciliationSummaryDigest", "sampleSummaryVersion", "sampleSummaryDigest",
    "populationCount", "selectedCount", "strata", "strataSummaryDigest",
    "expectedDigest", "actualDigest", "mismatchCount", "readinessEvidence",
    "qualified", "errorCode", "completedAt", "resultDigest", "traceId",
    "canonicalizationProfile", "runtimeEvidenceClaim"
  ],
  "properties": {
    "schemaVersion": {"const": "QUALITY-RECOVERY-VALIDATION-RESULT-1.1.0"},
    "resultId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "jobId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "jobVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "recoveryRequestId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "episodeId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "taskId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "state": {"enum": ["succeeded", "failed", "cancelled"]},
    "targetState": {"const": "recovering"},
    "transitionApplied": {"const": false},
    "inputDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "qualityRecoveryPolicyVersion": {"const": "QRP-1.0.0"},
    "qualityRecoveryPolicyDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "backfillStartWatermarkDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "backfillTargetWatermarkDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "backfillSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "reconciliationExpectedCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "reconciliationActualCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "reconciliationMismatchCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "reconciliationSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "sampleSummaryVersion": {"const": "QUALITY-RECOVERY-SAMPLE-SUMMARY-1.0.0"},
    "sampleSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "populationCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "selectedCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "strata": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/stratumSummary"}},
    "strataSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "expectedDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "actualDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "mismatchCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "readinessEvidence": {"$ref": "#/$defs/readinessEvidence"},
    "qualified": {"type": "boolean"},
    "errorCode": {"oneOf": [{"enum": ["READINESS_NOT_MET", "BACKFILL_FAILED", "RECONCILIATION_MISMATCH", "SAMPLE_INSUFFICIENT", "SAMPLE_MISMATCH", "PROVIDER_NOT_INSTALLED", "DEPENDENCY_UNAVAILABLE", "CANCELLED"]}, {"type": "null"}]},
    "completedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
    "resultDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "traceId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/traceId"},
    "canonicalizationProfile": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/canonicalizationProfile"},
    "runtimeEvidenceClaim": {"const": "installed-and-verified"}
  },
  "$defs": {
    "eligibilityBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["eligibilityId", "ruleId", "ruleVersion", "expectedAggregateVersion"],
      "properties": {
        "eligibilityId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
        "ruleId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$"},
        "ruleVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "expectedAggregateVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "qualityEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotIdsDigest", "snapshotHashesDigest", "metricResultsDigest", "allRequiredMetricsPassed", "sourceWatermark", "dependencyWatermark"],
      "properties": {
        "snapshotIdsDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "snapshotHashesDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "metricResultsDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "allRequiredMetricsPassed": {"type": "boolean"},
        "sourceWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "dependencyWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"}
      }
    },
    "batchEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sequenceEvidenceVersion", "sequenceEvidenceDigest", "requiredConsecutivePassedBatches", "actualConsecutivePassedBatches", "qualified"],
      "properties": {
        "sequenceEvidenceVersion": {"const": "QUALITY-RECOVERY-BATCH-SEQUENCE-1.0.0"},
        "sequenceEvidenceDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "requiredConsecutivePassedBatches": {"enum": [2, 3]},
        "actualConsecutivePassedBatches": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "qualified": {"type": "boolean"}
      }
    },
    "backfillEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["lastKnownGoodWatermark", "trustedNow", "lookbackDays", "backfillStartWatermark", "backfillCompletedWatermark", "evidenceDigest", "status"],
      "properties": {
        "lastKnownGoodWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "trustedNow": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
        "lookbackDays": {"const": 90},
        "backfillStartWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "backfillCompletedWatermark": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/watermark"},
        "evidenceDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "status": {"enum": ["succeeded", "failed", "unavailable"]}
      }
    },
    "readinessEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["episodeGeneration", "expectedEpisodeVersion", "expectedTaskVersion", "sourceId", "dependencyId", "ruleVersionsDigest", "memberSetDigest", "watermarksDigest", "sourceClass", "sourceSchemaVersion", "sourceSchemaDigest", "dependencyVersion", "dependencyDigest", "eligibilityBindings", "currentBindingDigest", "qualityEvidence", "batchEvidence", "backfillEvidence", "requiredMembersEligible", "missingEvidenceCodes", "impactAlreadyExpiredCount", "impactPotentiallyActionableCount", "impactExpectedToExpireCount", "trustedStartedAt", "evidenceDigest"],
      "properties": {
        "episodeGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expectedEpisodeVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expectedTaskVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sourceId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/sourceId"},
        "dependencyId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/dependencyId"},
        "ruleVersionsDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "memberSetDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "watermarksDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "sourceClass": {"enum": ["streaming", "dailyBatch"]},
        "sourceSchemaVersion": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sourceSchemaDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "dependencyVersion": {"type": "string", "pattern": "^[1-9][0-9]{0,15}$"},
        "dependencyDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "eligibilityBindings": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/eligibilityBinding"}},
        "currentBindingDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
        "qualityEvidence": {"$ref": "#/$defs/qualityEvidence"},
        "batchEvidence": {"$ref": "#/$defs/batchEvidence"},
        "backfillEvidence": {"$ref": "#/$defs/backfillEvidence"},
        "requiredMembersEligible": {"type": "boolean"},
        "missingEvidenceCodes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["QUALITY_GATE_NOT_PASSED", "CONSECUTIVE_BATCHES_INSUFFICIENT", "BACKFILL_INCOMPLETE", "RECONCILIATION_MISMATCH", "SAMPLE_INSUFFICIENT", "SAMPLE_MISMATCH", "SAMPLE_PROVIDER_UNAVAILABLE", "REQUIRED_DEPENDENCY_NOT_ELIGIBLE", "ACTIVE_EPISODE_MISSING", "OPEN_RECOVERY_TASK_MISSING", "VERSION_OR_DIGEST_UNKNOWN"]}},
        "impactAlreadyExpiredCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "impactPotentiallyActionableCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "impactExpectedToExpireCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "trustedStartedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
        "evidenceDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"}
      }
    }
  },
  "x-resultRules": [
    "qualified requires empty readinessEvidence.missingEvidenceCodes, exact currentBindingDigest, all required current members eligible, exact QG/QMDP/QSHM evidence, the source-class batch threshold, max(LKG,trustedNow-P90D) backfill, full reconciliation, and the QRP sample bound",
    "readinessEvidence is a PII-free owner-private projection sealed into resultDigest and rechecked before finalization and execution",
    "success remains validation evidence and never authorizes execution"
  ],
  "x-predecessor": "quality-recovery-validation-result.schema.json"
}
