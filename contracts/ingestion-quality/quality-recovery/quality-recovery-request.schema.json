{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/ingestion-quality/quality-recovery/quality-recovery-request.schema.json",
  "title": "Quality recovery request command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actionType",
    "currentState",
    "targetState",
    "object",
    "policy",
    "sourceClass",
    "reasonCode",
    "makerPrincipalDigest",
    "authorizationContextDigest",
    "authenticationStateDigest",
    "authorizationGeneration",
    "scopeDigest",
    "impactScopeDigest",
    "dataSensitivity",
    "selectionSeed",
    "requestedAt",
    "requestDigest",
    "idempotencyKey",
    "traceId",
    "canonicalizationProfile",
    "runtimeEvidenceClaim"
  ],
  "properties": {
    "schemaVersion": {"const": "QUALITY-RECOVERY-REQUEST-1.0.0"},
    "actionType": {"const": "quality-fuse.recover"},
    "currentState": {"const": "fused"},
    "targetState": {"const": "recovering"},
    "object": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/recoveryObjectBinding"},
    "policy": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/recoveryPolicyBinding"},
    "sourceClass": {"enum": ["streaming", "dailyBatch"]},
    "reasonCode": {"enum": ["QUALITY_EVIDENCE_REVALIDATION_REQUESTED"]},
    "makerPrincipalDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "authorizationContextDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "authenticationStateDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "authorizationGeneration": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "scopeDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "impactScopeDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "dataSensitivity": {"enum": ["internal", "sensitive", "highly-sensitive-deidentified"]},
    "selectionSeed": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "requestedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
    "requestDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "idempotencyKey": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$"},
    "traceId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/traceId"},
    "canonicalizationProfile": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/canonicalizationProfile"},
    "runtimeEvidenceClaim": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/runtimeEvidenceClaim"}
  },
  "x-crossFieldBindings": [
    "object.recoveryRequestId is the stable business idempotency key",
    "requestDigest covers every field except runtimeEvidenceClaim",
    "same recoveryRequestId and idempotencyKey with another requestDigest is conflict",
    "policy versions and digests are exact; unknown or drifted bindings fail closed",
    "client payload never carries approval receipt, execution token, execution lease or highRiskApprovals"
  ],
  "x-maximumWireBytes": 65536
}
