    "studentPlaintext": "forbidden",
    "createsRuleEvaluationCandidateOrClue": false
  },
  "impactPreview": {
    "authorizesExecution": false,
    "immutableInputs": ["ruleVersionsDigest", "memberSetDigest", "watermarksDigest", "qrpDigest", "trustedServerNow", "observationDuration"],
