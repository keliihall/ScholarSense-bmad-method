  "databaseConcurrency": {
    "commonScope": "sourceId",
    "firstLock": "pg_advisory_xact_lock(hashtextextended('quality-eligibility:'||sourceId,0))",
    "firstLockRequiredBefore": [
      "idempotency-row-lock", "eligibility-row-lock", "episode-row-lock", "task-row-lock",
      "request-row-lock", "approval-evidence-row-lock", "job-row-lock"
