  "twoPhaseRecovery": {
    "story25bTargetState": "recovering",
    "story25cTargetState": "eligible",
    "story25bTokenReusableAfterObservation": false,
    "story25cRequiresCurrentApprovalEvidenceRecheck": true,
    "story25cRequiresFreshExecutionConfirmation": true,
    "latestActionableFinalDecisionOwner": "2.5c"
  },
  "sampleRecompute": {
    "producer": "signal-evaluation",
