    "conflictingEntrances": {
      "V15-iq-accept-quality-eligibility-event-v1": "already-acquires-common-source-lock-before-row-locks",
      "V16-iq-accept-quality-eligibility-event-v2": "V17-forward-create-or-replace-must-acquire-common-source-lock-before-fuse-idempotency-row-lock",
      "V17-quality-recovery-command": "must-acquire-common-source-lock-before-any-row-or-idempotency-lock"
    },
    "afterCommonLockOrder": [
      "affected-rule-advisory-locks-sorted-by-ruleId-ruleVersion",
      "active-episode", "open-recovery-task", "current-eligibilities-sorted-by-ruleId-ruleVersion",
      "recovery-request", "approval-evidence", "validation-job"
    ],
    "doesNotReplace": ["aggregate-version-CAS", "lock-inside-reread", "deterministic-row-order"],
    "predecessorBytes": "V15-and-V16-unchanged"
  },
  "retention": {
