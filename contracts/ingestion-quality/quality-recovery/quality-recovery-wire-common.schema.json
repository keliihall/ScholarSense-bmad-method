{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/ingestion-quality/quality-recovery/quality-recovery-wire-common.schema.json",
  "title": "Story 2.5b quality recovery wire primitives",
  "$defs": {
    "uuidV7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instantMicros": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^SRC-P[01]-[A-Z0-9-]+-[0-9]{3}$"
    },
    "dependencyId": {
      "type": "string",
      "pattern": "^DEP-P[01]-[A-Z0-9-]+-[0-9]{3}$"
    },
    "ruleVersionRef": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}@[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$"
    },
    "watermark": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-=]{0,511}$"
    },
    "versionDigestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9.-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "recoveryPolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualityRecoveryPolicyVersion",
        "qualityRecoveryPolicyDigest",
        "highRiskActionPolicyVersion",
        "highRiskActionPolicyDigest",
        "highRiskActionMatrixVersion",
        "highRiskActionMatrixDigest",
        "roleFieldPolicyVersion",
        "roleFieldPolicyDigest",
        "dataContractCatalogVersion",
        "dataContractCatalogDigest",
        "qualityGateVersion",
        "qualityGateDigest",
        "qualityMetricDecisionProfileVersion",
        "qualityMetricDecisionProfileDigest",
        "qualitySnapshotHashProfileVersion",
        "qualitySnapshotHashProfileDigest",
        "ruleDependencyRegistryVersion",
        "ruleDependencyRegistryDigest",
        "ruleCatalogVersion",
        "ruleCatalogDigest"
      ],
      "properties": {
        "qualityRecoveryPolicyVersion": {"const": "QRP-1.0.0"},
        "qualityRecoveryPolicyDigest": {"$ref": "#/$defs/digest"},
        "highRiskActionPolicyVersion": {"const": "HRAP-1.0.0"},
        "highRiskActionPolicyDigest": {"$ref": "#/$defs/digest"},
        "highRiskActionMatrixVersion": {"const": "HRAM-1.0.0"},
        "highRiskActionMatrixDigest": {"$ref": "#/$defs/digest"},
        "roleFieldPolicyVersion": {"const": "RFP-1.0.0"},
        "roleFieldPolicyDigest": {"$ref": "#/$defs/digest"},
        "dataContractCatalogVersion": {"const": "DCC-1.1.0"},
        "dataContractCatalogDigest": {"$ref": "#/$defs/digest"},
        "qualityGateVersion": {"const": "QG-1.0.0"},
        "qualityGateDigest": {"$ref": "#/$defs/digest"},
        "qualityMetricDecisionProfileVersion": {"const": "QMDP-1.0.0"},
        "qualityMetricDecisionProfileDigest": {"$ref": "#/$defs/digest"},
        "qualitySnapshotHashProfileVersion": {"const": "QSHM-1.0.0"},
        "qualitySnapshotHashProfileDigest": {"$ref": "#/$defs/digest"},
        "ruleDependencyRegistryVersion": {"const": "RULE-DEPENDENCY-REGISTRY-1.0.0"},
        "ruleDependencyRegistryDigest": {"$ref": "#/$defs/digest"},
        "ruleCatalogVersion": {"const": "RC-1.0.0"},
        "ruleCatalogDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "recoveryObjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recoveryRequestId",
        "eligibilityId",
        "episodeId",
        "taskId",
        "episodeGeneration",
        "sourceId",
        "dependencyId",
        "expectedEligibilityVersion",
        "expectedEpisodeVersion",
        "expectedTaskVersion",
        "ruleVersionsDigest",
        "memberSetDigest",
        "watermarksDigest"
      ],
      "properties": {
        "recoveryRequestId": {"$ref": "#/$defs/uuidV7"},
        "eligibilityId": {"$ref": "#/$defs/uuidV7"},
        "episodeId": {"$ref": "#/$defs/uuidV7"},
        "taskId": {"$ref": "#/$defs/uuidV7"},
        "episodeGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sourceId": {"$ref": "#/$defs/sourceId"},
        "dependencyId": {"$ref": "#/$defs/dependencyId"},
        "expectedEligibilityVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expectedEpisodeVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expectedTaskVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "ruleVersionsDigest": {"$ref": "#/$defs/digest"},
        "memberSetDigest": {"$ref": "#/$defs/digest"},
        "watermarksDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "stratumSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratumCode", "populationCount", "selectedCount", "mismatchCount", "summaryDigest"],
      "properties": {
        "stratumCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "populationCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "selectedCount": {"type": "integer", "minimum": 0, "maximum": 10000},
        "mismatchCount": {"type": "integer", "minimum": 0, "maximum": 10000},
        "summaryDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "canonicalizationProfile": {"const": "SCHOLARSENSE-CANONICAL-JSON-1.0.0"},
    "runtimeEvidenceClaim": {"const": "contract-only"}
  }
}
