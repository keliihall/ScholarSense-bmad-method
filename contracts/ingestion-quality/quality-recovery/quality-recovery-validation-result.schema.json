{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/ingestion-quality/quality-recovery/quality-recovery-validation-result.schema.json",
  "title": "Immutable quality recovery validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "jobId", "jobVersion", "recoveryRequestId", "episodeId", "taskId", "state", "targetState", "transitionApplied", "inputDigest", "qualityRecoveryPolicyVersion", "qualityRecoveryPolicyDigest", "backfillSummaryDigest", "reconciliationSummaryDigest", "sampleSummaryVersion", "sampleSummaryDigest", "populationCount", "selectedCount", "strataSummaryDigest", "mismatchCount", "qualified", "errorCode", "completedAt", "resultDigest", "traceId", "canonicalizationProfile", "runtimeEvidenceClaim"],
  "properties": {
    "schemaVersion": {"const": "QUALITY-RECOVERY-VALIDATION-RESULT-1.0.0"},
    "resultId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "jobId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "jobVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "recoveryRequestId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "episodeId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "taskId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "state": {"enum": ["succeeded", "failed", "cancelled"]},
    "targetState": {"const": "recovering"},
    "transitionApplied": {"const": false},
    "inputDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "qualityRecoveryPolicyVersion": {"const": "QRP-1.0.0"},
    "qualityRecoveryPolicyDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "backfillSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "reconciliationSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "sampleSummaryVersion": {"const": "QUALITY-RECOVERY-SAMPLE-SUMMARY-1.0.0"},
    "sampleSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "populationCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "selectedCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "strataSummaryDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "mismatchCount": {"type": "integer", "minimum": 0, "maximum": 10000},
    "qualified": {"type": "boolean"},
    "errorCode": {"oneOf": [{"enum": ["BACKFILL_FAILED", "RECONCILIATION_MISMATCH", "SAMPLE_INSUFFICIENT", "SAMPLE_MISMATCH", "PROVIDER_NOT_INSTALLED", "DEPENDENCY_UNAVAILABLE", "CANCELLED"]}, {"type": "null"}]},
    "completedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
    "resultDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "traceId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/traceId"},
    "canonicalizationProfile": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/canonicalizationProfile"},
    "runtimeEvidenceClaim": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/runtimeEvidenceClaim"}
  },
  "x-resultRules": ["success is an immutable validation summary and never authorizes execution", "qualified requires full reconciliation and sample mismatchCount=0 with the QRP sample bound", "no student identifiers, raw rows, raw failures or free text"]
}
