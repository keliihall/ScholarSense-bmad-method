{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/ingestion-quality/quality-recovery/quality-recovery-validation-job.schema.json",
  "title": "Durable quality recovery validation job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "jobVersion", "recoveryRequestId", "episodeId", "taskId", "state", "targetState", "inputDigest", "qualityRecoveryPolicyVersion", "qualityRecoveryPolicyDigest", "ruleVersionsDigest", "memberSetDigest", "watermarksDigest", "selectionSeed", "leaseGeneration", "leaseOwnerDigest", "leaseExpiresAt", "attemptCount", "maximumAttempts", "checkpointVersion", "resultDigest", "errorCode", "createdAt", "updatedAt", "traceId", "runtimeEvidenceClaim"],
  "properties": {
    "schemaVersion": {"const": "QUALITY-RECOVERY-VALIDATION-JOB-1.0.0"},
    "jobId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "jobVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "recoveryRequestId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "episodeId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "taskId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/uuidV7"},
    "state": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
    "targetState": {"const": "recovering"},
    "inputDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "qualityRecoveryPolicyVersion": {"const": "QRP-1.0.0"},
    "qualityRecoveryPolicyDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "ruleVersionsDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "memberSetDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "watermarksDigest": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "selectionSeed": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"},
    "leaseGeneration": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "leaseOwnerDigest": {"oneOf": [{"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"}, {"type": "null"}]},
    "leaseExpiresAt": {"oneOf": [{"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"}, {"type": "null"}]},
    "attemptCount": {"type": "integer", "minimum": 0, "maximum": 5},
    "maximumAttempts": {"const": 5},
    "checkpointVersion": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "resultDigest": {"oneOf": [{"$ref": "quality-recovery-wire-common.schema.json#/$defs/digest"}, {"type": "null"}]},
    "errorCode": {"oneOf": [{"enum": ["PROVIDER_NOT_INSTALLED", "DEPENDENCY_UNAVAILABLE", "LEASE_EXPIRED", "STALE_FENCE", "RETRY_EXHAUSTED", "CANCELLED"]}, {"type": "null"}]},
    "createdAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
    "updatedAt": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/instantMicros"},
    "traceId": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/traceId"},
    "runtimeEvidenceClaim": {"$ref": "quality-recovery-wire-common.schema.json#/$defs/runtimeEvidenceClaim"}
  },
  "x-stateRules": ["only current leaseGeneration may checkpoint or finalize", "external I/O occurs outside owner transactions", "provider unavailable or not installed never becomes success", "validation never creates RuleEvaluation, Candidate or Clue"]
}
