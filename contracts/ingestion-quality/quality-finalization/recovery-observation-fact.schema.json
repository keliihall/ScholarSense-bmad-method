{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery-observation-fact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["observationId", "recoveryId", "generation", "factType", "sourceId", "policyVersion", "factDigest", "watermark", "businessSequence", "observedAt", "traceId"],
  "properties": {
    "observationId": {"type": "string", "format": "uuid"},
    "recoveryId": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "factType": {"enum": ["sealed-batch", "quality-snapshot", "reconciliation", "sample-summary", "verified-quality-failure"]},
    "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z0-9-]{3,48}$"},
    "policyVersion": {"const": "QOFP-1.0.0"},
    "factDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "watermark": {"type": "string", "minLength": 1, "maxLength": 256},
    "businessSequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "observedAt": {"type": "string", "format": "date-time"},
    "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"}
  },
  "x-forbidden": ["studentRef", "studentName", "subjectRef", "rawRow", "freeText", "approvalReceipt", "executionToken"]
}
