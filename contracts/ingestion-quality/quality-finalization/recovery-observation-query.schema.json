{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery-observation-query.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["recoveryId", "recoveryVersion", "taskId", "taskVersion", "generation", "sourceClass", "policyVersion", "policyDigest", "status", "finalizationState", "approvalId", "approvalVersion", "consecutivePassedBatches", "requiredPassedBatches", "observedDurationMicros", "requiredDurationMicros", "observationDuration", "watermark", "recoveringStartedAt", "lastObservedAt", "latestActionableAt", "failedMembers", "failureReasonCode", "eligibilityStatus", "taskStatus", "taskClosedAt", "ownerResultDigest", "deliveryStatus", "deliveryAttempt", "deliveryNextAttemptAt", "eligibleForHandoffWindowCount", "historyOnlyWindowCount", "traceId"],
  "properties": {
    "recoveryId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "recoveryVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "taskId": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "taskVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "sourceClass": {"enum": ["streaming", "daily-batch"]},
    "policyVersion": {"const": "QRP-1.0.0"},
    "policyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["observing", "ready", "relapsed", "policy-drift", "finalized"]},
    "finalizationState": {"enum": ["not-requested", "approval-pending", "approval-approved", "approval-rejected", "cancelled", "finalizing", "executed"]},
    "approvalId": {"type": ["string", "null"], "format": "uuid"},
    "approvalVersion": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
    "consecutivePassedBatches": {"type": "integer", "minimum": 0},
    "requiredPassedBatches": {"enum": [2, 3]},
    "observedDurationMicros": {"type": "integer", "minimum": 0},
    "requiredDurationMicros": {"enum": [3600000000, 86400000000]},
    "observationDuration": {"enum": ["PT60M", "P1D"]},
    "watermark": {"type": ["string", "null"], "maxLength": 256},
    "recoveringStartedAt": {"type": "string", "format": "date-time"},
    "lastObservedAt": {"type": "string", "format": "date-time"},
    "latestActionableAt": {"type": ["string", "null"], "format": "date-time"},
    "failedMembers": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^DEP-P[01]-[A-Z0-9-]+-[0-9]{3}$"}},
    "failureReasonCode": {"type": ["string", "null"], "pattern": "^[A-Z0-9_]{3,64}$"},
    "eligibilityStatus": {"enum": ["fused", "recovering", "eligible"]},
    "taskStatus": {"enum": ["open", "closed"]},
    "taskClosedAt": {"type": ["string", "null"], "format": "date-time"},
    "ownerResultDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "deliveryStatus": {"enum": ["pending", "retrying", "confirmed", "failed"]},
    "deliveryAttempt": {"type": "integer", "minimum": 0},
    "deliveryNextAttemptAt": {"type": ["string", "null"], "format": "date-time"},
    "eligibleForHandoffWindowCount": {"type": "integer", "minimum": 0},
    "historyOnlyWindowCount": {"type": "integer", "minimum": 0},
    "traceId": {"type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$"}
  },
  "x-authorization": "owned-source-filter-before-pagination-and-sensitive-read-audit-before-response",
  "x-cache": "no-store",
  "x-referrerPolicy": "no-referrer"
}
