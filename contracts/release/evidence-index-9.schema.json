{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/release/evidence-index-9.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["version", "releaseVersion", "subjectManifestSha256", "releaseManifest", "manifestSignature", "evidence", "versionBindings", "createdAt"],
  "properties": {
    "version": {"const": "EVIDENCE-INDEX-9.0.0"},
    "releaseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "subjectManifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "releaseManifest": {"$ref": "#/$defs/reference"}, "manifestSignature": {"$ref": "#/$defs/signature"},
    "evidence": {"type": "array", "minItems": 18, "uniqueItems": true, "items": {"$ref": "#/$defs/node"}},
    "versionBindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/versionBinding"}},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "uri", "mediaType", "size", "binarySha256", "ociDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "minLength": 3}, "size": {"type": "integer", "minimum": 1},
        "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "stage", "version", "uri", "mediaType", "size", "binarySha256", "ociDigest", "subjectBinarySha256", "dependsOn"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["artifact", "artifact-signature", "brand-asset-manifest", "data-catalog-target-conformance", "formal-web-report", "host-sso-runtime-evidence", "provenance", "public-integration-target-conformance", "sbom-attestation", "sbom-cyclonedx", "sbom-spdx", "ui-token-manifest", "visual-baseline", "vulnerability-scan"]},
        "stage": {"enum": ["candidate-evidence", "artifact", "artifact-evidence", "artifact-signature"]},
        "version": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "mediaType": {"type": "string", "minLength": 3},
        "size": {"type": "integer", "minimum": 1}, "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "subjectBinarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subjectCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "subjectTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "scenarioSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "catalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qualityGateSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sourceCount": {"const": 17},
        "handoffRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "handoffDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"}, "environment": {"enum": ["test", "stage", "prod"]},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "stage", "version", "uri", "mediaType", "size", "binarySha256", "ociDigest", "subjectBinarySha256", "dependsOn"],
      "properties": {
        "id": {"const": "manifest-signature"}, "kind": {"const": "manifest-signature"}, "stage": {"const": "manifest-signature"},
        "version": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "mediaType": {"type": "string", "minLength": 3},
        "size": {"type": "integer", "minimum": 1}, "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "subjectBinarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dependsOn": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "release-manifest"}}
      }
    },
    "versionBinding": {
      "type": "object", "additionalProperties": false, "required": ["releaseVersion", "manifestSha256"],
      "properties": {"releaseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
