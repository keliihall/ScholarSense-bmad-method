{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarsense.suda.edu.cn/contracts/release/release-manifest-7.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "releaseVersion", "sourceCommit", "sourceInventory", "sourceArchive", "buildManifest", "buildAttempts", "canonicalizationProfile", "baselineApprovals", "runtimeEvidence", "controlledInputs", "locks", "artifacts", "evidence", "frozenAt"],
  "properties": {
    "version": {"const": "RELEASE-MANIFEST-7.0.0"},
    "releaseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceInventory": {"$ref": "#/$defs/reference"},
    "sourceArchive": {"$ref": "#/$defs/reference"},
    "buildManifest": {"$ref": "#/$defs/reference"},
    "buildAttempts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/attempt"}},
    "canonicalizationProfile": {"const": "SCHOLARSENSE-CANONICAL-JSON-1.0.0"},
    "baselineApprovals": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/baseline"}},
    "runtimeEvidence": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/runtime"}},
    "controlledInputs": {"type": "array", "minItems": 36, "maxItems": 36, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "locks": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "artifacts": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "evidence": {"type": "array", "minItems": 18, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "frozenAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "uri", "mediaType", "size", "binarySha256", "ociDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1}, "mediaType": {"type": "string", "minLength": 3},
        "size": {"type": "integer", "minimum": 1}, "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "buildInputSha256", "artifactSetSha256"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
        "buildInputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifactSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "uri", "mediaType", "size", "binarySha256", "ociDigest", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1}, "mediaType": {"type": "string", "minLength": 3},
        "size": {"type": "integer", "minimum": 1}, "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "status": {"const": "approved"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "pending-story-execution", "not-applicable", "deployment-input-required"]},
        "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decisionId": {"type": "string", "minLength": 1}, "ownerStory": {"type": "string", "minLength": 1},
        "runtimeEvidenceClaim": {"const": "none"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "version", "uri", "mediaType", "size", "binarySha256", "ociDigest"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"const": "artifact"}, "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "minLength": 3}, "size": {"type": "integer", "minimum": 1},
        "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "version", "uri", "mediaType", "size", "binarySha256", "ociDigest", "subjectBinarySha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["artifact-signature", "brand-asset-manifest", "data-catalog-target-conformance", "formal-web-report", "host-sso-runtime-evidence", "provenance", "public-integration-target-conformance", "sbom-attestation", "sbom-cyclonedx", "sbom-spdx", "ui-token-manifest", "visual-baseline", "vulnerability-scan"]},
        "version": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1},
        "mediaType": {"type": "string", "minLength": 3}, "size": {"type": "integer", "minimum": 1},
        "binarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "subjectBinarySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subjectCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "subjectTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "scenarioSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "catalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qualityGateSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sourceCount": {"const": 17},
        "handoffRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "handoffDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"}, "environment": {"enum": ["test", "stage", "prod"]}
      }
    }
  }
}
