{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholarsense:public-integration:evidence:1.0.0",
  "title": "PIC conformance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidenceClass", "subjectCommit", "subjectTree", "contractVersion", "contractDigest", "profileVersion", "profileDigest", "scenarioSetVersion", "scenarioSetDigest", "runAt", "command", "commandExitCode", "logDigest", "evidenceDigest", "productionEligible", "productionRuntimeClaim", "evidenceScope", "productionDomainObjectsCreated", "realBusinessObjectsCreated", "productionConsumerInstalled", "productionConsumerWatermarkAdvanced", "publicTaskLifecycleClaim", "conditionalSkipCount", "targetSandboxConnected", "overallResult", "failedCount", "skippedCount", "scenarioResults", "sandboxCleanupResult", "orphanCount", "approvedRetainedCount", "syntheticExternalObjectsCreated", "syntheticExternalObjectsClosed", "syntheticExternalObjectsRevoked", "referenceRouteWatermarkFrom", "referenceRouteWatermarkTo", "finalExternalState"],
  "properties": {
    "version": {"const": "PIC-EVIDENCE-1.0.0"},
    "evidenceClass": {"enum": ["local-isolated-committed-candidate", "target-managed-non-production-sandbox"]},
    "subjectCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subjectTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contractVersion": {"const": "PIC-1.0.0"},
    "contractDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profileVersion": {"const": "PIC-RUNTIME-1.0.0"},
    "profileDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenarioSetVersion": {"const": "PIC-TARGET-SCENARIOS-1.0.0"},
    "scenarioSetDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runAt": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1, "maxLength": 512},
    "commandExitCode": {"const": 0},
    "logDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "productionEligible": {"const": false},
    "productionRuntimeClaim": {"const": "none"},
    "evidenceScope": {"const": "contract-reference-adapter-only"},
    "productionDomainObjectsCreated": {"const": 0},
    "realBusinessObjectsCreated": {"const": 0},
    "productionConsumerInstalled": {"const": false},
    "productionConsumerWatermarkAdvanced": {"const": false},
    "publicTaskLifecycleClaim": {"const": "none"},
    "conditionalSkipCount": {"const": 0},
    "targetSandboxConnected": {"type": "boolean"},
    "handoffId": {"type": "string"},
    "handoffRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previousRevisionDigest": {"type": ["string", "null"]},
    "handoffBindingDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handoffExpectedDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handoffIssuedAt": {"type": "string", "format": "date-time"},
    "handoffNotBefore": {"type": "string", "format": "date-time"},
    "handoffExpiresAt": {"type": "string", "format": "date-time"},
    "signerKeyId": {"type": "string"},
    "trustRootDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signatureVerified": {"type": "boolean"},
    "approvedAuthorityDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "peerCertificateSpkiDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "peerCertificateChainDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sandboxRunId": {"type": "string"},
    "overallResult": {"enum": ["pass", "fail"]},
    "failedCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "skippedCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "scenarioResults": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/scenarioResult"}},
    "sandboxCleanupResult": {"enum": ["pass", "fail"]},
    "orphanCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "approvedRetainedCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "syntheticExternalObjectsCreated": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "syntheticExternalObjectsClosed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "syntheticExternalObjectsRevoked": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "referenceRouteWatermarkFrom": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "referenceRouteWatermarkTo": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "finalExternalState": {"enum": ["closed", "revoked", "none"]}
  },
  "$defs": {
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "receiptOrChallengeDigest", "sideEffectExpected", "sideEffectCount"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["pass", "fail", "skipped", "unsupported"]},
        "receiptOrChallengeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sideEffectExpected": {"type": "boolean"},
        "sideEffectCount": {"type": "integer", "minimum": 0, "maximum": 1},
        "externalReferenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "originalExternalReferenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "newObjectCount": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  }
}
