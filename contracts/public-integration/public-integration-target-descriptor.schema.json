{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholarsense:public-integration:target-descriptor:1.0.0",
  "title": "PIC target descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptorVersion", "authority", "environment", "baseUri", "peerSpkiSha256", "capabilities", "protocols"],
  "properties": {
    "descriptorVersion": {"const": "PIC-TARGET-DESCRIPTOR-1.0.0"},
    "authority": {"type": "string", "minLength": 1, "maxLength": 128},
    "environment": {"enum": ["development", "test", "staging", "non-production-sandbox"]},
    "baseUri": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?(?:/[^?#]*)?$"},
    "peerSpkiSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capabilities": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["public-task", "public-message", "status-result-writeback", "external-transfer-work-order", "metric-publication"]}},
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "challenge", "sandboxCleanup", "terminalByStableWorkItemKey", "rejectStaleSourceVersion"],
      "properties": {
        "receipt": {"const": "PIC-RECEIPT-1.0.0"},
        "challenge": {"const": "PIC-CHALLENGE-1.0.0"},
        "sandboxCleanup": {"const": "PIC-SANDBOX-CLEANUP-1.0.0"},
        "terminalByStableWorkItemKey": {"const": true},
        "rejectStaleSourceVersion": {"const": true}
      }
    }
  }
}
