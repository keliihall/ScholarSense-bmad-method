{
  "openapi": "3.1.2",
  "info": {
    "title": "ScholarSense assessed quality snapshots",
    "version": "1.0.0",
    "description": "Read-only, owner-scoped immutable quality evidence. runtimeEvidenceClaim=none."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"sessionCookie": []}],
  "paths": {
    "/quality-snapshots": {
      "get": {
        "operationId": "listQualitySnapshots",
        "summary": "List assessed immutable quality snapshots",
        "parameters": [
          {"$ref": "#/components/parameters/SourceId"},
          {"$ref": "#/components/parameters/OverallResult"},
          {"$ref": "#/components/parameters/EvaluatedFrom"},
          {"$ref": "#/components/parameters/EvaluatedTo"},
          {"$ref": "#/components/parameters/SortField"},
          {"$ref": "#/components/parameters/SortDirection"},
          {"$ref": "#/components/parameters/AfterEvaluatedAt"},
          {"$ref": "#/components/parameters/AfterSnapshotId"},
          {"$ref": "#/components/parameters/PageSize"}
        ],
        "responses": {
          "200": {
            "description": "Authorized assessed snapshot page",
            "headers": {"Cache-Control": {"schema": {"const": "no-store"}}, "Referrer-Policy": {"schema": {"const": "no-referrer"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QualitySnapshotPage"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/Concealed"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/quality-snapshots/{snapshotId}": {
      "get": {
        "operationId": "getQualitySnapshot",
        "summary": "Read one assessed immutable quality snapshot",
        "parameters": [{"$ref": "#/components/parameters/SnapshotId"}],
        "responses": {
          "200": {
            "description": "Authorized assessed snapshot",
            "headers": {"Cache-Control": {"schema": {"const": "no-store"}}, "Referrer-Policy": {"schema": {"const": "no-referrer"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QualitySnapshot"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/Concealed"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/quality-snapshots/{snapshotId}/metrics/{metricId}": {
      "get": {
        "operationId": "getQualitySnapshotMetric",
        "summary": "Read one materialized metric from an assessed snapshot",
        "parameters": [{"$ref": "#/components/parameters/SnapshotId"}, {"$ref": "#/components/parameters/MetricId"}, {"$ref": "#/components/parameters/FormulaId"}, {"$ref": "#/components/parameters/FormulaVersion"}],
        "responses": {
          "200": {
            "description": "Authorized immutable metric evidence",
            "headers": {"Cache-Control": {"schema": {"const": "no-store"}}, "Referrer-Policy": {"schema": {"const": "no-referrer"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/QualityMetricResult"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/Concealed"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {"type": "apiKey", "in": "cookie", "name": "JSESSIONID"}
    },
    "parameters": {
      "SnapshotId": {"name": "snapshotId", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/UuidV7"}},
      "MetricId": {"name": "metricId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}},
      "FormulaId": {"name": "formulaId", "in": "query", "required": true, "schema": {"type": "string", "maxLength": 256, "pattern": "^QMDP-1\\.0\\.0/[A-Za-z0-9._/-]{1,245}$"}},
      "FormulaVersion": {"name": "formulaVersion", "in": "query", "required": true, "schema": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
      "SourceId": {"name": "sourceId", "in": "query", "required": false, "schema": {"type": "string", "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}$"}},
      "OverallResult": {"name": "overallResult", "in": "query", "required": false, "schema": {"type": "string", "enum": ["quality-passed", "quality-failed"]}},
      "EvaluatedFrom": {"name": "evaluatedFrom", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/OffsetTimestamp"}},
      "EvaluatedTo": {"name": "evaluatedTo", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/OffsetTimestamp"}},
      "SortField": {"name": "sortField", "in": "query", "required": false, "schema": {"type": "string", "const": "evaluatedAt", "default": "evaluatedAt"}},
      "SortDirection": {"name": "sortDirection", "in": "query", "required": false, "schema": {"type": "string", "enum": ["asc", "desc"], "default": "desc"}},
      "AfterEvaluatedAt": {"name": "afterEvaluatedAt", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/OffsetTimestamp"}},
      "AfterSnapshotId": {"name": "afterSnapshotId", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/UuidV7"}},
      "PageSize": {"name": "size", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request",
        "headers": {"Cache-Control": {"schema": {"const": "no-store"}}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "Concealed": {
        "description": "Absent and unauthorized are indistinguishable",
        "headers": {"Cache-Control": {"schema": {"const": "no-store"}}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "Unavailable": {
        "description": "Authorization, owner evidence, trusted time, audit, or storage unavailable",
        "headers": {"Cache-Control": {"schema": {"const": "no-store"}}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      }
    },
    "schemas": {
      "UuidV7": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
      "OffsetTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
      "SafeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
      "Sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "ObservationWindow": {
        "type": "object", "additionalProperties": false,
        "required": ["startAt", "endAt"],
        "properties": {"startAt": {"$ref": "#/components/schemas/OffsetTimestamp"}, "endAt": {"$ref": "#/components/schemas/OffsetTimestamp"}}
      },
      "QualityMetricResult": {
        "type": "object", "additionalProperties": false,
        "required": ["metricId", "formulaId", "formulaVersion", "result", "applicable", "numerator", "denominator", "valueBasisPoints", "unit", "operator", "thresholdNumerator", "thresholdDenominator", "boundary", "reasonCode"],
        "properties": {
          "metricId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
          "formulaId": {"type": "string", "pattern": "^QMDP-1\\.0\\.0/.{1,244}$"},
          "formulaVersion": {"const": "1.0.0"},
          "result": {"type": "string", "enum": ["passed", "failed", "not-applicable"]},
          "applicable": {"type": "boolean"},
          "numerator": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "denominator": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "valueBasisPoints": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
          "unit": {"type": "string", "enum": ["basis-point", "count", "millisecond", "member-count"]},
          "operator": {"type": "string", "enum": [">=", "<=", "="]},
          "thresholdNumerator": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "thresholdDenominator": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "boundary": {"const": "inclusive"},
          "reasonCode": {"type": "null"}
        }
      },
      "QualitySnapshot": {
        "type": "object", "additionalProperties": false,
        "required": ["snapshotId", "batchId", "sourceId", "assessedBatchStatus", "overallResult", "observationWindow", "cutoffAt", "evaluatedAt", "watermark", "metricResults", "impactScopeCodes", "sourceOwnerRef", "approvalRef", "effectiveAt", "retentionScheduleVersion", "qualityMetricDecisionProfileVersion", "qualityMetricDecisionProfileDigest", "qualityGateVersion", "qualityGateDigest", "canonicalizationProfile", "manifestDigest", "sourceSchemaVersion", "sourceSchemaDigest", "immutableHash", "traceId", "lineageId", "supersedesSnapshotId", "aggregateVersion"],
        "properties": {
          "snapshotId": {"$ref": "#/components/schemas/UuidV7"},
          "batchId": {"$ref": "#/components/schemas/UuidV7"},
          "sourceId": {"type": "string", "pattern": "^SRC-P[01]-[A-Z-]+-[0-9]{3}$"},
          "assessedBatchStatus": {"type": "string", "enum": ["quality-passed", "quality-failed"]},
          "overallResult": {"type": "string", "enum": ["quality-passed", "quality-failed"]},
          "observationWindow": {"$ref": "#/components/schemas/ObservationWindow"},
          "cutoffAt": {"$ref": "#/components/schemas/OffsetTimestamp"},
          "evaluatedAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
          "watermark": {"type": "string", "minLength": 1, "maxLength": 512},
          "metricResults": {"type": "array", "minItems": 1, "maxItems": 14, "items": {"$ref": "#/components/schemas/QualityMetricResult"}},
          "impactScopeCodes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}},
          "sourceOwnerRef": {"type": "string", "minLength": 1, "maxLength": 256},
          "approvalRef": {"const": "AUTH-2026-08-08-001"},
          "effectiveAt": {"$ref": "#/components/schemas/OffsetTimestamp"},
          "retentionScheduleVersion": {"const": "RS-1.0.0"},
          "qualityMetricDecisionProfileVersion": {"const": "QMDP-1.0.0"},
          "qualityMetricDecisionProfileDigest": {"$ref": "#/components/schemas/Sha256"},
          "qualityGateVersion": {"const": "QG-1.0.0"},
          "qualityGateDigest": {"$ref": "#/components/schemas/Sha256"},
          "canonicalizationProfile": {"const": "SCHOLARSENSE-CANONICAL-JSON-1.0.0"},
          "manifestDigest": {"$ref": "#/components/schemas/Sha256"},
          "sourceSchemaVersion": {"type": "string", "minLength": 1, "maxLength": 128},
          "sourceSchemaDigest": {"$ref": "#/components/schemas/Sha256"},
          "immutableHash": {"$ref": "#/components/schemas/Sha256"},
          "traceId": {"type": "string", "pattern": "^(?!0{32})[0-9a-f]{32}$"},
          "lineageId": {"$ref": "#/components/schemas/UuidV7"},
          "supersedesSnapshotId": {"oneOf": [{"$ref": "#/components/schemas/UuidV7"}, {"type": "null"}]},
          "aggregateVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        }
      },
      "Cursor": {
        "type": "object", "additionalProperties": false,
        "required": ["evaluatedAt", "snapshotId"],
        "properties": {"evaluatedAt": {"$ref": "#/components/schemas/OffsetTimestamp"}, "snapshotId": {"$ref": "#/components/schemas/UuidV7"}}
      },
      "QualitySnapshotPage": {
        "type": "object", "additionalProperties": false,
        "required": ["items", "size", "hasMore", "nextCursor"],
        "properties": {
          "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/QualitySnapshot"}},
          "size": {"type": "integer", "minimum": 1, "maximum": 100},
          "hasMore": {"type": "boolean"},
          "nextCursor": {"oneOf": [{"$ref": "#/components/schemas/Cursor"}, {"type": "null"}]}
        }
      },
      "FieldError": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "code"],
        "properties": {"field": {"type": "string"}, "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}}
      },
      "Error": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "traceId", "currentVersion", "fieldErrors"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
          "traceId": {"type": "string", "pattern": "^(?!0{32})[0-9a-f]{32}$"},
          "currentVersion": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"type": "null"}]},
          "fieldErrors": {"type": "array", "items": {"$ref": "#/components/schemas/FieldError"}}
        }
      }
    }
  }
}
