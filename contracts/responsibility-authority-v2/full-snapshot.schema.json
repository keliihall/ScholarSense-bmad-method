{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/responsibility-authority-v2/full-snapshot.schema.json",
  "title": "Signed sealed responsibility V2 projection and lineage snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "contractVersion", "sourceId", "feedId",
    "consumerProjection", "snapshotId", "businessDate", "cutoffAt",
    "sourceVersion", "throughWatermark", "supportingIdentityOrgWatermarks",
    "sealed", "complete", "expectedCount", "canonicalDigest",
    "signatureDigest", "partitions", "records", "lineageDigestProfile", "lineageCount",
    "canonicalLineageDigest", "lineages", "traceId"
  ],
  "properties": {
    "$schema": {"const": "../../full-snapshot.schema.json"},
    "schemaVersion": {"const": "RESPONSIBILITY-SNAPSHOT-1.0.0"},
    "contractVersion": {"const": "RESPONSIBILITY-AUTHORITY-2.0.0"},
    "sourceId": {"const": "SRC-P0-RESPONSIBILITY-001"},
    "feedId": {"const": "responsibility-authority"},
    "consumerProjection": {"const": "responsibility"},
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "businessDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "cutoffAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sourceVersion": {"type": "integer", "minimum": 1},
    "throughWatermark": {"type": "integer", "minimum": 1},
    "supportingIdentityOrgWatermarks": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "sealed": {"const": true},
    "complete": {"const": true},
    "expectedCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "canonicalDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signatureDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "partitions": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
    },
    "records": {
      "type": "array", "maxItems": 1000000,
      "items": {"$ref": "#/$defs/currentRecord"}
    },
    "lineageDigestProfile": {
      "const": "RESPONSIBILITY-LINEAGE-DIGEST-1.0.0"
    },
    "lineageCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "canonicalLineageDigest": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lineages": {
      "type": "array", "maxItems": 1000000,
      "items": {"$ref": "#/$defs/lineage"}
    },
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  },
  "$defs": {
    "currentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationRefToken", "studentEquivalenceDomain", "recordVersion",
        "payloadDigest"
      ],
      "properties": {
        "relationRefToken": {
          "type": "string", "pattern": "^rtok_[A-Za-z0-9_-]{32,128}$"
        },
        "studentEquivalenceDomain": {
          "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recordVersion": {"type": "integer", "minimum": 1},
        "payloadDigest": {
          "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationRefToken", "lineageId", "rootEventId", "headEventId",
        "eventCount", "canonicalChainDigest"
      ],
      "properties": {
        "relationRefToken": {
          "type": "string", "pattern": "^rtok_[A-Za-z0-9_-]{32,128}$"
        },
        "lineageId": {
          "type": "string", "pattern": "^lin_[A-Za-z0-9_-]{32,128}$"
        },
        "rootEventId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "headEventId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "eventCount": {"type": "integer", "minimum": 1},
        "canonicalChainDigest": {
          "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
