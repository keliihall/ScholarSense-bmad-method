{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/responsibility-authority-v2/responsibility-relation.schema.json",
  "title": "Provider-neutral authoritative responsibility relation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relationRefToken",
    "studentSourceRef",
    "counselorAccountExternalRef",
    "collegeOrganizationExternalRef",
    "responsibilityType",
    "status",
    "effectiveFrom",
    "effectiveTo",
    "recordVersion",
    "lineageVersion",
    "changeKind",
    "reasonCode",
    "effectiveAt",
    "lineageId",
    "supersedesId",
    "payloadDigest"
  ],
  "properties": {
    "relationRefToken": {
      "type": "string",
      "pattern": "^rtok_[A-Za-z0-9_-]{32,128}$"
    },
    "studentSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purposeCode",
        "keyVersion",
        "tokenValue",
        "digest",
        "equivalenceDomain"
      ],
      "properties": {
        "purposeCode": {"const": "RESPONSIBILITY-STUDENT-REF"},
        "keyVersion": {
          "type": "string",
          "enum": ["resp-student-v1", "resp-student-v2"]
        },
        "tokenValue": {
          "type": "string",
          "pattern": "^stok_[A-Za-z0-9_-]{32,128}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "equivalenceDomain": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "counselorAccountExternalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "collegeOrganizationExternalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "responsibilityType": {
      "type": "string",
      "enum": ["primary", "secondary"]
    },
    "status": {"type": "string", "enum": ["active", "inactive"]},
    "effectiveFrom": {"type": "string", "format": "date-time"},
    "effectiveTo": {"type": ["string", "null"], "format": "date-time"},
    "recordVersion": {"type": "integer", "minimum": 1},
    "lineageVersion": {"type": "integer", "minimum": 1},
    "changeKind": {
      "type": "string",
      "enum": [
        "corrected",
        "revoked",
        "expired",
        "invalidated",
        "revalidated"
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "DIRECT_RESPONSIBILITY_CHANGE",
        "RELATION_EXPIRED",
        "COMPLETE_SNAPSHOT_MISSING",
        "QUALITY_GATE_INVALID",
        "RECONCILIATION_RECOVERED",
        "SOURCE_CORRECTION"
      ]
    },
    "effectiveAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "lineageId": {
      "type": "string",
      "pattern": "^lin_[A-Za-z0-9_-]{32,128}$"
    },
    "supersedesId": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
