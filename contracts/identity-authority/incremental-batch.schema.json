{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/identity-authority/incremental-batch.schema.json",
  "title": "Provider-neutral identity and organization incremental batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultType",
    "sourceId",
    "feedId",
    "partitionId",
    "consumerProjection",
    "batchId",
    "sourceVersion",
    "fromWatermark",
    "toWatermark",
    "sourceVisibleAt",
    "observedAt",
    "traceId",
    "correlationId",
    "mappingVersion",
    "mappingDigest",
    "signatureDigest",
    "records"
  ],
  "properties": {
    "$schema": {"type": "string", "const": "../../incremental-batch.schema.json"},
    "schemaVersion": {"type": "string", "const": "IDENTITY-AUTHORITY-BATCH-1.0.0"},
    "resultType": {"type": "string", "enum": ["changes", "heartbeat"]},
    "sourceId": {"type": "string", "const": "SRC-P0-RESPONSIBILITY-001"},
    "feedId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "partitionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "consumerProjection": {"type": "string", "const": "identity-org"},
    "batchId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "sourceVersion": {"type": "integer", "minimum": 1},
    "fromWatermark": {"type": "integer", "minimum": 0},
    "toWatermark": {"type": "integer", "minimum": 1},
    "sourceVisibleAt": {"type": "string", "format": "date-time"},
    "observedAt": {"type": "string", "format": "date-time"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "correlationId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "mappingVersion": {"type": "string", "const": "IDENTITY-ROLE-MAPPING-1.0.0"},
    "mappingDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signatureDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "records": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "recordKind",
          "sourceVersion",
          "effectiveFrom",
          "effectiveTo",
          "payloadDigest",
          "payload"
        ],
        "properties": {
          "eventId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
          "recordKind": {
            "type": "string",
            "enum": ["account", "organization", "employment-role"]
          },
          "sourceVersion": {"type": "integer", "minimum": 1},
          "effectiveFrom": {"type": "string", "format": "date-time"},
          "effectiveTo": {"type": ["string", "null"], "format": "date-time"},
          "payloadDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "payload": {"type": "object"}
        }
      }
    }
  }
}
