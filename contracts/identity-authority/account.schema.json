{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/identity-authority/account.schema.json",
  "title": "Normalized authoritative account",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "externalRef",
    "issuer",
    "subject",
    "status",
    "effectiveFrom",
    "effectiveTo",
    "recordVersion"
  ],
  "properties": {
    "externalRef": {"type": "string", "minLength": 1, "maxLength": 128},
    "issuer": {"type": "string", "pattern": "^https://[a-z0-9.-]+(?:/[^#]*)?$"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 255},
    "status": {"type": "string", "enum": ["active", "inactive"]},
    "effectiveFrom": {"type": "string", "format": "date-time"},
    "effectiveTo": {"type": ["string", "null"], "format": "date-time"},
    "recordVersion": {"type": "integer", "minimum": 1}
  }
}
