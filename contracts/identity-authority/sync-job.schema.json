{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.scholarsense.invalid/identity-authority/sync-job.schema.json",
  "title": "Persistent identity synchronization job and attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "sourceId",
    "feedId",
    "partitionId",
    "consumerProjection",
    "status",
    "health",
    "freshness",
    "attemptNo",
    "fencingToken",
    "inputWatermark",
    "outputWatermark",
    "lastSuccessfulWatermark",
    "requestedAt",
    "startedAt",
    "completedAt",
    "nextAttemptAt",
    "reasonCode",
    "traceId"
  ],
  "properties": {
    "$schema": {"type": "string", "const": "../../sync-job.schema.json"},
    "jobId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "sourceId": {"type": "string", "const": "SRC-P0-RESPONSIBILITY-001"},
    "feedId": {"type": "string", "minLength": 1},
    "partitionId": {"type": "string", "minLength": 1},
    "consumerProjection": {"type": "string", "const": "identity-org"},
    "status": {"type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
    "health": {"type": "string", "enum": ["healthy", "degraded"]},
    "freshness": {"type": "string", "enum": ["fresh", "stale"]},
    "attemptNo": {"type": "integer", "minimum": 1},
    "fencingToken": {"type": "integer", "minimum": 1},
    "inputWatermark": {"type": "integer", "minimum": 0},
    "outputWatermark": {"type": ["integer", "null"], "minimum": 0},
    "lastSuccessfulWatermark": {"type": "integer", "minimum": 0},
    "requestedAt": {"type": "string", "format": "date-time"},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "nextAttemptAt": {"type": ["string", "null"], "format": "date-time"},
    "reasonCode": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
